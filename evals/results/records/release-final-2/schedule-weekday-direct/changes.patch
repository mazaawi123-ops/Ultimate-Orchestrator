+    def test_weekday_next_run(self):
+        mock_job = make_mock_job()
+        # (now, expected next run); may 6 2024 == Monday
+        cases = [
+            ((2024, 5, 6, 8, 0), (2024, 5, 6, 9, 0)),  # monday before 09:00
+            ((2024, 5, 6, 9, 0), (2024, 5, 7, 9, 0)),  # monday at 09:00
+            ((2024, 5, 6, 10, 0), (2024, 5, 7, 9, 0)),  # monday -> tuesday
+            ((2024, 5, 9, 10, 0), (2024, 5, 10, 9, 0)),  # thursday -> friday
+            ((2024, 5, 10, 8, 59), (2024, 5, 10, 9, 0)),  # friday before 09:00
+            ((2024, 5, 10, 9, 1), (2024, 5, 13, 9, 0)),  # friday -> monday
+            ((2024, 5, 11, 8, 0), (2024, 5, 13, 9, 0)),  # saturday -> monday
+            ((2024, 5, 11, 10, 0), (2024, 5, 13, 9, 0)),  # saturday -> monday
+            ((2024, 5, 12, 8, 0), (2024, 5, 13, 9, 0)),  # sunday -> monday
+            ((2024, 5, 12, 23, 59), (2024, 5, 13, 9, 0)),  # sunday -> monday
+        ]
+        for now, expected in cases:
+            with self.subTest(now=now):
+                schedule.clear()
+                with mock_datetime(*now):
+                    job = every().weekday.at("09:00").do(mock_job)
+                    assert job.next_run == datetime.datetime(*expected)
+

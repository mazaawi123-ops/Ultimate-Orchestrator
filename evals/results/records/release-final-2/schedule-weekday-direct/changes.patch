+    def test_run_pending_weekday_runs_monday_to_friday_only(self):
+        runs = []
+        mock_job = make_mock_job()
+        mock_job.side_effect = lambda: runs.append(datetime.datetime.now())
+
+        start = datetime.datetime(2024, 5, 6, 0, 30)  # monday
+        with mock_datetime(start.year, start.month, start.day, 0, 0):
+            every().weekday.at("09:00").do(mock_job)
+
+        # Call run_pending() every 30 minutes for two whole weeks
+        for step in range(14 * 48):
+            moment = start + datetime.timedelta(minutes=30 * step)
+            with mock_datetime(
+                moment.year, moment.month, moment.day, moment.hour, moment.minute
+            ):
+                schedule.run_pending()
+
+        assert len(runs) == 10
+        assert [run.weekday() for run in runs] == [0, 1, 2, 3, 4] * 2
+        assert all((run.hour, run.minute) == (9, 0) for run in runs)
+

+    def test_weekday_next_run_skips_weekend(self):
+        mock_job = make_mock_job()
+        # january 1 2020 == Wednesday
+        expected = {
+            # (day, hour) of "now" -> day of the next run at 09:00
+            (1, 8): 1,  # Wednesday before 09:00 -> today
+            (1, 10): 2,  # Wednesday after 09:00 -> Thursday
+            (2, 10): 3,  # Thursday -> Friday
+            (3, 8): 3,  # Friday before 09:00 -> today
+            (3, 9): 6,  # Friday at 09:00 -> Monday
+            (3, 10): 6,  # Friday after 09:00 -> Monday
+            (4, 8): 6,  # Saturday before 09:00 -> Monday
+            (4, 10): 6,  # Saturday after 09:00 -> Monday
+            (5, 8): 6,  # Sunday before 09:00 -> Monday
+            (5, 23): 6,  # Sunday late -> Monday
+            (6, 8): 6,  # Monday before 09:00 -> today
+            (6, 10): 7,  # Monday after 09:00 -> Tuesday
+        }
+        for (day, hour), next_day in expected.items():
+            with mock_datetime(2020, 1, day, hour, 0):
+                schedule.clear()
+                job = every().weekday.at("09:00").do(mock_job)
+                assert job.unit == "days"
+                assert job.next_run == datetime.datetime(2020, 1, next_day, 9, 0), (
+                    day,
+                    hour,
+                    job.next_run,
+                )
+                assert job.next_run.weekday() < 5
+
+    def test_weekday_runs_monday_to_friday_only(self):
+        runs = []
+
+        def job():
+            runs.append(datetime.datetime.now())
+
+        # Start on Wednesday january 1 2020 and step through three weeks
+        start = datetime.datetime(2020, 1, 1, 0, 0)
+        with mock_datetime(2020, 1, 1, 0, 0):
+            every().weekday.at("09:00").do(job)
+        for step in range(21 * 24 * 4):
+            now = start + datetime.timedelta(minutes=15 * step)
+            with mock_datetime(now.year, now.month, now.day, now.hour, now.minute):
+                schedule.run_pending()
+
+        assert all(run.weekday() < 5 for run in runs)
+        assert all((run.hour, run.minute) == (9, 0) for run in runs)
+        run_days = [run.date() for run in runs]
+        expected_days = [
+            (start + datetime.timedelta(days=i)).date()
+            for i in range(21)
+            if (start + datetime.timedelta(days=i)).weekday() < 5
+        ]
+        assert run_days == expected_days
+        assert len(run_days) == 15
+

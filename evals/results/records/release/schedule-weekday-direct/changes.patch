+    def test_weekday_next_run(self):
+        # january 4 2010 == Monday, january 9 and 10 2010 == Saturday and Sunday
+        expected = {
+            # (day, hour): (next run day, next run hour)
+            (4, 8): (4, 9),  # Monday before 09:00 -> today
+            (4, 10): (5, 9),  # Monday after 09:00 -> Tuesday
+            (7, 10): (8, 9),  # Thursday after 09:00 -> Friday
+            (8, 8): (8, 9),  # Friday before 09:00 -> today
+            (8, 10): (11, 9),  # Friday after 09:00 -> Monday
+            (9, 8): (11, 9),  # Saturday -> Monday
+            (9, 10): (11, 9),
+            (10, 8): (11, 9),  # Sunday -> Monday
+            (10, 10): (11, 9),
+        }
+        for (day, hour), (next_day, next_hour) in expected.items():
+            schedule.clear()
+            with mock_datetime(2010, 1, day, hour, 0):
+                job = every().weekday.at("09:00").do(make_mock_job())
+                assert job.next_run == datetime.datetime(
+                    2010, 1, next_day, next_hour, 0
+                ), (day, hour, job.next_run)
+                assert job.next_run.weekday() < 5
+
+    def test_weekday_without_at_time(self):
+        with mock_datetime(2010, 1, 8, 10, 30):  # Friday
+            job = every().weekday.do(make_mock_job())
+            assert job.next_run == datetime.datetime(2010, 1, 11, 10, 30)
+        with mock_datetime(2010, 1, 6, 10, 30):  # Wednesday
+            job = every().weekday.do(make_mock_job())
+            assert job.next_run == datetime.datetime(2010, 1, 7, 10, 30)
+
+    def test_run_every_weekday_at_specific_time(self):
+        run_times = []
+        mock_job = make_mock_job()
+        mock_job.side_effect = lambda: run_times.append(datetime.datetime.now())
+
+        with mock_datetime(2010, 1, 3, 12, 0):  # Sunday
+            every().weekday.at("09:00").do(mock_job)
+
+        # Poll every 15 minutes for two full weeks
+        moment = datetime.datetime(2010, 1, 3, 12, 0)
+        while moment < datetime.datetime(2010, 1, 17, 12, 0):
+            moment += datetime.timedelta(minutes=15)
+            with mock_datetime(
+                moment.year, moment.month, moment.day, moment.hour, moment.minute
+            ):
+                schedule.run_pending()
+
+        assert run_times == [
+            datetime.datetime(2010, 1, day, 9, 0)
+            for day in (4, 5, 6, 7, 8, 11, 12, 13, 14, 15)
+        ]
+        assert all(t.weekday() < 5 for t in run_times)
+
+    def test_weekday_late_run_is_skipped_on_weekend(self):

+    def test_weekday_next_run(self):
+        # January 4 2010 is a Monday, January 9 and 10 are the weekend
+        cases = [
+            ((2010, 1, 4, 8, 0), datetime.datetime(2010, 1, 4, 9, 0)),  # Mon before
+            ((2010, 1, 4, 10, 0), datetime.datetime(2010, 1, 5, 9, 0)),  # Mon after
+            ((2010, 1, 7, 10, 0), datetime.datetime(2010, 1, 8, 9, 0)),  # Thu after
+            ((2010, 1, 8, 8, 0), datetime.datetime(2010, 1, 8, 9, 0)),  # Fri before
+            ((2010, 1, 8, 9, 0), datetime.datetime(2010, 1, 11, 9, 0)),  # Fri at
+            ((2010, 1, 8, 10, 0), datetime.datetime(2010, 1, 11, 9, 0)),  # Fri after
+            ((2010, 1, 9, 8, 0), datetime.datetime(2010, 1, 11, 9, 0)),  # Sat
+            ((2010, 1, 10, 8, 0), datetime.datetime(2010, 1, 11, 9, 0)),  # Sun before
+            ((2010, 1, 10, 23, 59), datetime.datetime(2010, 1, 11, 9, 0)),  # Sun late
+        ]
+        for now, expected in cases:
+            with mock_datetime(*now):
+                job = every().weekday.at("09:00").do(make_mock_job())
+                assert job.unit == "days"
+                assert job.next_run == expected, (now, job.next_run)
+
+    def test_weekday_without_at_skips_weekend(self):
+        with mock_datetime(2010, 1, 8, 10, 30):  # Friday
+            job = every().weekday.do(make_mock_job())
+            assert job.next_run == datetime.datetime(2010, 1, 11, 10, 30)
+        with mock_datetime(2010, 1, 7, 10, 30):  # Thursday
+            job = every().weekday.do(make_mock_job())
+            assert job.next_run == datetime.datetime(2010, 1, 8, 10, 30)
+
+    def test_weekday_runs_monday_to_friday_only(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 3, 12, 0):  # Sunday
+            every().weekday.at("09:00").do(mock_job)
+
+        run_days = []
+        for day in range(4, 18):  # Mon Jan 4 through Sun Jan 17
+            for hour, minute in [(0, 0), (8, 59), (9, 0), (9, 1), (12, 0), (23, 59)]:
+                with mock_datetime(2010, 1, day, hour, minute):
+                    before = mock_job.call_count
+                    schedule.run_pending()
+                    if mock_job.call_count != before:
+                        run_days.append((day, hour, minute))
+
+        assert run_days == [
+            (day, 9, 0) for day in (4, 5, 6, 7, 8, 11, 12, 13, 14, 15)
+        ], run_days
+
+    def test_weekday_job_due_friday_is_not_run_on_weekend(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 8, 8, 0):  # Friday
+            job = every().weekday.at("09:00").do(mock_job)
+        assert job.next_run == datetime.datetime(2010, 1, 8, 9, 0)
+
+        # The process was not polling on Friday; it catches up on Saturday
+        with mock_datetime(2010, 1, 9, 10, 0):
+            schedule.run_pending()
+            assert mock_job.call_count == 0
+            assert job.next_run == datetime.datetime(2010, 1, 11, 9, 0)
+            schedule.run_all()
+            assert mock_job.call_count == 0
+
+        with mock_datetime(2010, 1, 11, 9, 0):
+            schedule.run_pending()
+            assert mock_job.call_count == 1
+

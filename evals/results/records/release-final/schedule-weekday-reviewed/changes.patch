+    def test_run_every_weekday_at_specific_time(self):
+        """Poll every 15 minutes for three weeks: the job runs exactly once
+        on each day from Monday to Friday, at 09:00, and never on the weekend."""
+        runs = []
+        mock_job = make_mock_job()
+        mock_job.side_effect = lambda: runs.append(datetime.datetime.now())
+
+        start = datetime.datetime(2010, 1, 2, 0, 0)  # Saturday
+        with mock_datetime(start.year, start.month, start.day, 0, 0):
+            every().weekday.at("09:00").do(mock_job)
+
+        moment = start
+        while moment < start + datetime.timedelta(weeks=3):
+            with mock_datetime(
+                moment.year, moment.month, moment.day, moment.hour, moment.minute
+            ):
+                schedule.run_pending()
+            moment += datetime.timedelta(minutes=15)
+
+        assert len(runs) == 15
+        assert all(run.weekday() < 5 for run in runs)
+        assert all((run.hour, run.minute) == (9, 0) for run in runs)
+        assert len({run.date() for run in runs}) == 15
+

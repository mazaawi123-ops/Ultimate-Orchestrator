@@ -0,0 +1,170 @@
+import json
+import pytest
+from datetime import date
+from todo.store import Store, parse_due
+
+
+def test_parse_due_valid_formats():
+    """Valid dates should return unchanged."""
+    assert parse_due("2026-10-01") == "2026-10-01"
+    assert parse_due("2024-02-29") == "2024-02-29"
+
+
<email>("invalid_date", [
+    "2026-13-01",           # invalid month
+    "2026-02-30",           # invalid day for February
+    "2026-02-29",           # 2026 is not a leap year
+    "20261001",             # no hyphens (fullmatch required)
+    "2026-W40-4",           # ISO week format
+    "2026-1-01",            # single digit month
+    "2026-10-1",            # single digit day
+    "2026-10-01T00:00",     # timestamp
+    "",                     # empty string
+    " 2026-10-01",          # leading space
+    "2026-10-01\n",         # trailing newline
+    "２０２６-10-01",         # fullwidth digits
+    "tomorrow",             # plain text
+])
+def test_parse_due_invalid_formats(invalid_date):
+    """Invalid dates should raise ValueError with specific message."""
+    with pytest.raises(ValueError) as excinfo:
+        parse_due(invalid_date)
+    expected_msg = f"invalid due date {invalid_date!r}: expected YYYY-MM-DD"
+    assert str(excinfo.value) == expected_msg
+
+
+def test_add_with_due(tmp_path):
+    """Adding an item with a due date should include it in JSON."""
+    s = Store(tmp_path / "db.json")
+    item = s.add("pay rent", due="2026-10-01")
+    assert item["due"] == "2026-10-01"
+
+    # Verify JSON file content
+    file_content = json.loads((tmp_path / "db.json").read_text())
+    assert file_content == [{"id": 1, "title": "pay rent", "done": False, "due": "2026-10-01"}]
+
+
+def test_add_without_due(tmp_path):
+    """Adding an item without a due date should not include due key."""
+    s = Store(tmp_path / "db.json")
+    item = s.add("milk")
+    assert "due" not in item
+
+    # Verify JSON file content - no due key
+    file_content = json.loads((tmp_path / "db.json").read_text())
+    assert file_content == [{"id": 1, "title": "milk", "done": False}]
+
+
+def test_add_with_invalid_due(tmp_path):
+    """Adding an item with invalid due date should raise ValueError without saving."""
+    s = Store(tmp_path / "db.json")
+    with pytest.raises(ValueError):
+        s.add("x", due="2026-13-01")
+
+    # File should not exist - nothing was saved
+    assert not (tmp_path / "db.json").exists()
+    assert s.items == []
+
+
+def test_overdue_with_specific_today(tmp_path):
+    """Test overdue with specific today date."""
+    s = Store(tmp_path / "db.json")
+    s.add("yesterday", due="2026-09-22")
+    s.add("today", due="2026-09-23")
+    s.add("tomorrow", due="2026-09-24")
+
+    completed = s.add("old done", due="2026-09-01")
+    s.complete(completed["id"])
+
+    s.add("no due")
+    s.add("long ago", due="2000-01-01")
+
+    result = s.overdue(today=date(2026, 9, 23))
+    titles = [i["title"] for i in result]
+    assert titles == ["yesterday", "long ago"]
+
+
+def test_overdue_default_today(tmp_path):
+    """Test overdue uses date.today() by default."""
+    s = Store(tmp_path / "db.json")
+    s.add("past", due="2000-01-01")
+    s.add("future", due="2999-12-31")
+
+    result = s.overdue()
+    titles = [i["title"] for i in result]
+    assert titles == ["past"]
+
+
+def test_overdue_skips_junk(tmp_path):
+    """Test overdue silently skips malformed due values."""
+    p = tmp_path / "db.json"
+    data = [
+        {"id": 1, "title": "a", "done": False, "due": None},
+        {"id": 2, "title": "b", "done": False, "due": 5},
+        {"id": 3, "title": "c", "done": False, "due": "tomorrow"},
+        {"id": 4, "title": "d", "done": False, "due": "2026-02-30"},
+        {"id": 5, "title": "e", "done": False, "due": "2000-01-01"},
+    ]
+    p.write_text(json.dumps(data))
+
+    s = Store(p)
+    result = s.overdue(today=date(2026, 9, 23))
+    titles = [i["title"] for i in result]
+    assert titles == ["e"]
+
+
+def test_overdue_skips_non_yyyymmdd_formats(tmp_path):
+    """Test overdue skips alternative ISO formats that fromisoformat accepts."""
+    p = tmp_path / "db.json"
+    data = [
+        {"id": 1, "title": "compact", "done": False, "due": "20000101"},
+        {"id": 2, "title": "week", "done": False, "due": "2000-W01-1"},
+        {"id": 3, "title": "ok", "done": False, "due": "2000-01-01"},
+    ]
+    p.write_text(json.dumps(data))
+
+    s = Store(p)
+    result = s.overdue(today=date(2026, 9, 23))
+    titles = [i["title"] for i in result]
+    assert titles == ["ok"]
+
+
+def test_overdue_empty_store(tmp_path):
+    """Test overdue on empty store returns empty list."""
+    s = Store(tmp_path / "db.json")
+    result = s.overdue(today=date(2026, 9, 23))
+    assert result == []
+
+
+def test_old_file_without_due(tmp_path):
+    """Test reading and working with old format files."""
+    p = tmp_path / "db.json"
+    # Write an old-format file
+    p.write_text(json.dumps([{"id": 1, "title": "old", "done": False}]))
+
+    s = Store(p)
+
+    # Old item should be readable
+    assert [i["title"] for i in s.list()] == ["old"]
+
+    # overdue should skip items without due
+    assert s.overdue(today=date(2026, 9, 23)) == []
+
+    # Add new item with due
+    s.add("new", due="2026-10-01")
+
+    # Add new item without due
+    s.add("plain")
+
+    # Verify file format
+    file_content = json.loads(p.read_text())
+    assert file_content == [
+        {"id": 1, "title": "old", "done": False},
+        {"id": 2, "title": "new", "done": False, "due": "2026-10-01"},
+        {"id": 3, "title": "plain", "done": False},
+    ]
+
+    # complete() should work on old item
+    s.complete(1)
+    file_after_complete = json.loads(p.read_text())
+    assert file_after_complete[0]["done"] is True

 import json
+import re
+from datetime import date
 from pathlib import Path
 
 
+def parse_due(value):
+    """Parse and validate a due date string in YYYY-MM-DD format.
+
+    Args:
+        value: A string representing a date.
+
+    Returns:
+        The value unchanged (as a str) if valid.
+
+    Raises:
+        ValueError: If the value does not match YYYY-MM-DD format or is not a valid date.
+    """
+    if re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", value) is None:
+        raise ValueError(f"invalid due date {value!r}: expected YYYY-MM-DD")
+    try:
+        date.fromisoformat(value)
+    except ValueError:
+        raise ValueError(f"invalid due date {value!r}: expected YYYY-MM-DD") from None
+    return value
+
+
 class Store:
-    """JSON-backed todo storage. Each item: {"id": int, "title": str, "done": bool}."""
+    """JSON-backed todo storage. Each item: {"id": int, "title": str, "done": bool, "due"?: "YYYY-MM-DD"}."""
 
     def __init__(self, path):
         self.path = Path(path)
@@ -14,9 +37,13 @@ class Store:
     def save(self):
         self.path.write_text(json.dumps(self.items, indent=2))
 
-    def add(self, title):
+    def add(self, title, due=None):
         new_id = max((i["id"] for i in self.items), default=0) + 1
+        if due is not None:
+            due = parse_due(due)
         item = {"id": new_id, "title": title, "done": False}
+        if due is not None:
+            item["due"] = due
         self.items.append(item)
         self.save()
         return item
@@ -29,5 +56,35 @@ class Store:
                 return i
         raise KeyError(item_id)
 
+    def overdue(self, today=None):
+        """Return items that are not done and have a due date before today.
+
+        Args:
+            today: A datetime.date object. Defaults to date.today().
+
+        Returns:
+            A list of items where not done, due is a valid YYYY-MM-DD date string,
+            and the date is strictly before today. Items are in file order.
+            Silently skips items with no due date, non-string due values, or
+            malformed date strings.
+        """
+        if today is None:
+            today = date.today()
+        result = []
+        for i in self.items:
+            if i["done"]:
+                continue
+            due = i.get("due")
+            if not isinstance(due, str):
+                continue
+            try:
+                parse_due(due)
+                due_date = date.fromisoformat(due)
+            except ValueError:
+                continue
+            if due_date < today:
+                result.append(i)
+        return result
+
     def list(self, include_done=False):
         return [i for i in self.items if include_done or not i["done"]]

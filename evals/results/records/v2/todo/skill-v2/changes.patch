+import json
+import pytest
+from todo.cli import main
+
+
+def run(db, *args):
+    """Helper to run the CLI with a temp db path."""
+    main(["--db", str(db), *args])
+
+
+def test_add_with_due(tmp_path, capsys):
+    """Adding an item with --due should store the date and print without suffix."""
+    db = tmp_path / "db.json"
+    run(db, "add", "pay rent", "--due", "2026-10-01")
+    out, err = capsys.readouterr()
+    assert out == "added #1: pay rent\n"
+    assert err == ""
+
+    # Verify the file has the due date
+    data = json.loads(db.read_text())
+    assert len(data) == 1
+    assert data[0]["id"] == 1
+    assert data[0]["title"] == "pay rent"
+    assert data[0]["done"] is False
+    assert data[0]["due"] == "2026-10-01"
+
+
+def test_add_without_due(tmp_path, capsys):
+    """Adding an item without --due should not include due key."""
+    db = tmp_path / "db.json"
+    run(db, "add", "milk")
+    out, err = capsys.readouterr()
+    assert out == "added #1: milk\n"
+    assert err == ""
+
+    # Verify the file does not have due key
+    data = json.loads(db.read_text())
+    assert len(data) == 1
+    assert data[0] == {"id": 1, "title": "milk", "done": False}
+
+
+def test_add_with_due_before_title(tmp_path, capsys):
+    """--due can come before the title."""
+    db = tmp_path / "db.json"
+    run(db, "add", "--due", "2026-10-01", "x")
+    out, err = capsys.readouterr()
+    assert out == "added #1: x\n"
+
+    data = json.loads(db.read_text())
+    assert data[0]["due"] == "2026-10-01"
+
+
<email>("bad_due", [
+    "2026-13-01",       # invalid month
+    "2026-02-30",       # invalid day
+    "20261001",         # no hyphens
+    "2026-1-01",        # single digit month
+    "2026-10-01T00:00", # timestamp
+    "",                 # empty string
+])
+def test_add_invalid_due(tmp_path, capsys, bad_due):
+    """Invalid due dates should exit with code 2, error on stderr, no file created."""
+    db = tmp_path / "db.json"
+    with pytest.raises(SystemExit) as exc_info:
+        run(db, "add", "x", "--due", bad_due)
+
+    assert exc_info.value.code == 2
+    out, err = capsys.readouterr()
+    assert out == ""
+    assert f"invalid due date {bad_due!r}: expected YYYY-MM-DD" in err
+    assert not db.exists()
+
+
+def test_add_invalid_due_existing_db(tmp_path, capsys):
+    """Invalid due on existing db should leave it unchanged."""
+    db = tmp_path / "db.json"
+    # Add a valid item first
+    run(db, "add", "a")
+    original_text = db.read_text()
+
+    # Now try to add with invalid due
+    capsys.readouterr()  # Clear previous output
+    with pytest.raises(SystemExit):
+        run(db, "add", "b", "--due", "2026-13-01")
+
+    # File should be unchanged
+    assert db.read_text() == original_text
+
+
+def test_list_with_due(tmp_path, capsys):
+    """List should show due dates for items that have them."""
+    db = tmp_path / "db.json"
+    run(db, "add", "pay rent", "--due", "2026-10-01")
+    run(db, "add", "milk")
+
+    capsys.readouterr()  # Clear previous output
+    run(db, "list")
+    out, err = capsys.readouterr()
+
+    assert out == "[ ] #1 pay rent (due 2026-10-01)\n[ ] #2 milk\n"
+    assert err == ""
+
+
+def test_list_all_shows_done_with_due(tmp_path, capsys):
+    """list --all should show done items with due dates."""
+    db = tmp_path / "db.json"
+    run(db, "add", "a", "--due", "2000-01-02")
+    run(db, "done", "1")
+
+    capsys.readouterr()  # Clear previous output
+    run(db, "list", "--all")
+    out, err = capsys.readouterr()
+
+    assert "[x] #1 a (due 2000-01-02)\n" in out
+
+    # list without --all should be empty
+    capsys.readouterr()
+    run(db, "list")
+    out, err = capsys.readouterr()
+    assert out == ""
+
+
+def test_overdue(tmp_path, capsys):
+    """overdue should list only open items due strictly before today."""
+    db = tmp_path / "db.json"
+    run(db, "add", "a", "--due", "2000-01-01")
+    run(db, "add", "b", "--due", "2999-12-31")
+    run(db, "add", "c", "--due", "2000-01-02")
+    run(db, "add", "d")
+    run(db, "done", "3")
+
+    capsys.readouterr()  # Clear previous output
+    run(db, "overdue")
+    out, err = capsys.readouterr()
+
+    # Only item 1 ("a") should be shown - it's overdue, open, and earliest
+    assert out == "[ ] #1 a (due 2000-01-01)\n"
+    assert err == ""
+
+
+def test_overdue_nonexistent_db(tmp_path, capsys):
+    """overdue on a nonexistent db should print nothing."""
+    db = tmp_path / "db.json"
+    run(db, "overdue")
+    out, err = capsys.readouterr()
+
+    assert out == ""
+    assert err == ""
+
+
+def test_old_format_file(tmp_path, capsys):
+    """Old format files (without due) should work correctly."""
+    db = tmp_path / "db.json"
+    db.write_text(json.dumps([{"id": 1, "title": "old", "done": False}]))
+
+    # list should work
+    run(db, "list")
+    out, err = capsys.readouterr()
+    assert out == "[ ] #1 old\n"
+
+    # overdue should return nothing
+    run(db, "overdue")
+    out, err = capsys.readouterr()
+    assert out == ""
+
+    # add with due should work
+    run(db, "add", "new", "--due", "2026-10-01")
+    out, err = capsys.readouterr()
+    assert out == "added #2: new\n"
+
+    # done should work on old item
+    run(db, "done", "1")
+    out, err = capsys.readouterr()
+    assert out == "done #1\n"
+
+    # Verify file still has no due key on old item
+    data = json.loads(db.read_text())
+    assert data[0] == {"id": 1, "title": "old", "done": True}
+
+
+def test_hand_edited_due_null(tmp_path, capsys):
+    """Items with due: null should print without due suffix."""
+    db = tmp_path / "db.json"
+    db.write_text(json.dumps([{"id": 1, "title": "n", "done": False, "due": None}]))
+
+    run(db, "list")
+    out, err = capsys.readouterr()
+    assert out == "[ ] #1 n\n"
+
+    run(db, "overdue")
+    out, err = capsys.readouterr()
+    assert out == ""

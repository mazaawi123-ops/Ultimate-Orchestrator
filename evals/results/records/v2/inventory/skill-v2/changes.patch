+import pytest
+from pathlib import Path
+from inventory.stock import Inventory
+
+
+def test_import_csv_basic(tmp_path):
+    """sku,qty\nA,5\n\nB,2\n → returns 2; level A == 5, B == 2"""
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_text("sku,qty\nA,5\n\nB,2\n", newline="")
+    result = inv.import_csv(csv_file)
+    assert result == 2
+    assert inv.level("A") == 5
+    assert inv.level("B") == 2
+
+
+def test_import_csv_crlf(tmp_path):
+    """CRLF line endings → returns 2; A == 5, B == 2"""
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_text("sku,qty\r\nA,5\r\n\r\nB,2\r\n", newline="")
+    result = inv.import_csv(csv_file)
+    assert result == 2
+    assert inv.level("A") == 5
+    assert inv.level("B") == 2
+
+
+def test_import_csv_utf8_bom(tmp_path):
+    """UTF-8 BOM at start → returns 1; A == 5"""
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_bytes(b"\xef\xbb\xbfsku,qty\nA,5\n")
+    result = inv.import_csv(csv_file)
+    assert result == 1
+    assert inv.level("A") == 5
+
+
+def test_import_csv_blank_lines_before_header(tmp_path):
+    """Blank lines before header → returns 1; A == 5"""
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_text("\n\nsku,qty\nA,5\n", newline="")
+    result = inv.import_csv(csv_file)
+    assert result == 1
+    assert inv.level("A") == 5
+
+
+def test_import_csv_whitespace_header_and_values(tmp_path):
+    """Whitespace-padded header and values → returns 1; level("A") == 5"""
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_text(" SKU , QTY \n  A  ,  5  \n", newline="")
+    result = inv.import_csv(csv_file)
+    assert result == 1
+    assert inv.level("A") == 5
+
+
+def test_import_csv_mixed_blank_lines(tmp_path):
+    """Mixed blank lines (empty, whitespace, commas) → returns 2; A == 5, B == 3"""
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_text("sku,qty\nA,5\n,\n  \n B , 3\n", newline="")
+    result = inv.import_csv(csv_file)
+    assert result == 2
+    assert inv.level("A") == 5
+    assert inv.level("B") == 3
+
+
+def test_import_csv_duplicate_skus(tmp_path):
+    """Duplicate SKUs accumulate → returns 2; A == 8"""
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_text("sku,qty\nA,5\nA,3\n", newline="")
+    result = inv.import_csv(csv_file)
+    assert result == 2
+    assert inv.level("A") == 8
+
+
+def test_import_csv_existing_stock(tmp_path):
+    """Existing stock + import → level combines"""
+    inv = Inventory()
+    inv.receive("A", 1)
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_text("sku,qty\nA,5\n", newline="")
+    result = inv.import_csv(csv_file)
+    assert result == 1
+    assert inv.level("A") == 6

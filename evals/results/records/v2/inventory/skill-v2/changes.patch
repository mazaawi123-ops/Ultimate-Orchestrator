+    def import_csv(self, path):
+        with open(path, newline="", encoding="utf-8-sig") as f:
+            reader = csv.reader(f)
+            pending = []
+            header_seen = False
+
+            for row in reader:
+                line_num = reader.line_num
+
+                # Check if blank row
+                if all(field.strip() == "" for field in row):
+                    continue
+
+                # First non-blank row should be header
+                if not header_seen:
+                    header_row = [f.strip().lower() for f in row]
+                    if header_row != ["sku", "qty"]:
+                        raise ValueError(f"line {line_num}: expected header 'sku,qty'")
+                    header_seen = True
+                    continue
+
+                # Validate data row
+                # a. Check column count
+                if len(row) != 2:
+                    raise ValueError(f"line {line_num}: expected 2 columns (sku,qty), got {len(row)}")
+
+                # b. Check SKU is not empty
+                sku = row[0].strip()
+                if sku == "":
+                    raise ValueError(f"line {line_num}: missing sku")
+
+                # c. Check qty is valid positive integer
+                raw = row[1].strip()
+                if re.fullmatch(r"[0-9]+", raw) is None or int(raw) == 0:
+                    raise ValueError(f"line {line_num}: qty must be a positive integer, got {raw!r}")
+
+                # d. Append to pending
+                pending.append((sku, int(raw)))
+
+            # After validation, receive all rows
+            for sku, qty in pending:
+                self.receive(sku, qty)
+
+            return len(pending)
+

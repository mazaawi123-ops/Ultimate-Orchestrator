--- /dev/null
+++ b/src/truncate.js
@@ -0,0 +1,11 @@
+// Shorten text to at most `max` code points (ellipsis included); never splits a surrogate pair.
+export function truncate(text, max, ellipsis = "…") {
+  if (!Number.isInteger(max) || max < 0) {
+    throw new RangeError("max must be a non-negative integer");
+  }
+  const chars = Array.from(String(text));
+  if (chars.length <= max) return chars.join("");
+  const tail = Array.from(String(ellipsis));
+  if (tail.length >= max) return tail.slice(0, max).join("");
+  return chars.slice(0, max - tail.length).join("") + tail.join("");
+}

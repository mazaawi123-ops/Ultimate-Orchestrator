index 0000000..7e1dc48
--- /dev/null
+++ b/src/truncate.js
@@ -0,0 +1,15 @@
+// Cut text to max code points including ellipsis, avoiding split surrogates.
+export function truncate(text, max, ellipsis = "…") {
+  if (!Number.isInteger(max) || max < 0) {
+    throw new RangeError("truncate: max must be a non-negative integer");
+  }
+  const chars = Array.from(String(text));
+  const dots = Array.from(String(ellipsis));
+  if (chars.length <= max) {
+    return String(text);
+  }
+  if (max < dots.length) {
+    return chars.slice(0, max).join("");
+  }
+  return chars.slice(0, max - dots.length).join("") + dots.join("");
+}

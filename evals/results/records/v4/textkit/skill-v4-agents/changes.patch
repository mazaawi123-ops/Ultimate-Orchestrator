@@ -0,0 +1,13 @@
+// Cut text to at most `max` code points, including the ellipsis.
+export function truncate(text, max, ellipsis = "…") {
+  if (!Number.isInteger(max) || max < 0) {
+    throw new RangeError("max must be a non-negative integer");
+  }
+  const str = String(text);
+  const chars = Array.from(str);
+  if (chars.length <= max) return str;
+  const tail = String(ellipsis);
+  const tailLen = Array.from(tail).length;
+  if (tailLen > max) return chars.slice(0, max).join("");
+  return chars.slice(0, max - tailLen).join("") + tail;
+}

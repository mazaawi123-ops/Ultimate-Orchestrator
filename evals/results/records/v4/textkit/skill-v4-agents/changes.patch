@@ -5,3 +5,86 @@ import { wrap } from "../src/wrap.js";
 test("wraps at width", () => {
   assert.equal(wrap("aaa bbb ccc ddd", 7), "aaa bbb\nccc ddd");
 });
+
+test("hard-breaks long word", () => {
+  assert.equal(wrap("abcdefghij", 4), "abcd\nefgh\nij");
+});
+
+test("long word with short words after", () => {
+  assert.equal(wrap("abcdefg hi", 5), "abcde\nfg hi");
+});
+
+test("short word then long word", () => {
+  assert.equal(wrap("ab cdefghij", 4), "ab\ncdef\nghij");
+});
+
+test("word exactly width", () => {
+  assert.equal(wrap("aaaa", 4), "aaaa");
+});
+
+test("long word with space and short word", () => {
+  assert.equal(wrap("abcdefgh ij", 4), "abcd\nefgh\nij");
+});
+
+test("multiple long words", () => {
+  assert.equal(wrap("x abcdefgh y", 3), "x\nabc\ndef\ngh\ny");
+});
+
+test("width 1", () => {
+  assert.equal(wrap("abcdef", 1), "a\nb\nc\nd\ne\nf");
+});
+
+test("emoji hard-break", () => {
+  assert.equal(wrap("😀😀😀😀😀", 2), "😀😀\n😀😀\n😀");
+});
+
+test("empty string", () => {
+  assert.equal(wrap("", 5), "");
+});
+
+test("multiple spaces and newlines", () => {
+  assert.equal(wrap("a  b\n\ncdefgh", 3), "a b\ncde\nfgh");
+});
+
+test("width 0 throws RangeError", () => {
+  assert.throws(() => wrap("test", 0), RangeError);
+});
+
+test("width -1 throws RangeError", () => {
+  assert.throws(() => wrap("test", -1), RangeError);
+});
+
+test("width 1.5 throws RangeError", () => {
+  assert.throws(() => wrap("test", 1.5), RangeError);
+});
+
+test("property test: no line exceeds width", () => {
+  const text = "The quick brownfoxjumpedoverthelazydog and 😀😀😀😀😀😀😀 ok";
+  for (let width = 1; width <= 12; width++) {
+    const result = wrap(text, width);
+    const lines = result.split("\n");
+    for (const line of lines) {
+      assert(Array.from(line).length <= width, `Line exceeds width ${width}: "${line}" (${Array.from(line).length} chars)`);
+    }
+    // Check all words are preserved in order by removing spaces and comparing
+    const wrappedNoSpace = result.replace(/[ \n]/g, "");
+    const originalNoSpace = text.replace(/\s+/g, "");
+    assert.equal(wrappedNoSpace, originalNoSpace);
+  }
+});
+
+test("astral fit: '😀 a' at width 3 fits on one line", () => {
+  assert.equal(wrap("😀 a", 3), "😀 a");
+});
+
+test("astral fit: '😀😀 😀😀' at width 5 fits on one line", () => {
+  assert.equal(wrap("😀😀 😀😀", 5), "😀😀 😀😀");
+});
+
+test("astral fit: 'ab😀 c' at width 5 fits on one line", () => {
+  assert.equal(wrap("ab😀 c", 5), "ab😀 c");
+});
+
+test("astral fit boundary: '😀😀 😀😀' at width 4 wraps", () => {
+  assert.equal(wrap("😀😀 😀😀", 4), "😀😀\n😀😀");
+});

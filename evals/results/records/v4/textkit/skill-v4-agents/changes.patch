@@ -0,0 +1,46 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { truncate } from "../src/truncate.js";
+import * as textkit from "../src/index.js";
+
+test("truncate('hello world', 8) → 'hello w…'", () => assert.equal(truncate("hello world", 8), "hello w…"));
+test("truncate('hello', 5) → 'hello'", () => assert.equal(truncate("hello", 5), "hello"));
+test("truncate('hello', 10) → 'hello'", () => assert.equal(truncate("hello", 10), "hello"));
+test("truncate('hello world', 8, '...') → 'hello...'", () => assert.equal(truncate("hello world", 8, "..."), "hello..."));
+test("truncate('hello', 0) → ''", () => assert.equal(truncate("hello", 0), ""));
+test("truncate('hello', 1) → '…'", () => assert.equal(truncate("hello", 1), "…"));
+test("truncate('hello', 2, '...') → 'he'", () => assert.equal(truncate("hello", 2, "..."), "he"));
+test("truncate('hello', 3, '...') → '...'", () => assert.equal(truncate("hello", 3, "..."), "..."));
+test("truncate('hello', 4, '') → 'hell'", () => assert.equal(truncate("hello", 4, ""), "hell"));
+test("truncate('', 0) → ''", () => assert.equal(truncate("", 0), ""));
+test("truncate('a😀b😀c', 4) → 'a😀b…'", () => assert.equal(truncate("a😀b😀c", 4), "a😀b…"));
+test("truncate('a😀b😀c', 3) → 'a😀…'", () => assert.equal(truncate("a😀b😀c", 3), "a😀…"));
+test("truncate('😀😀😀', 2) → '😀…'", () => assert.equal(truncate("😀😀😀", 2), "😀…"));
+test("truncate('a😀b😀c', 5) → 'a😀b😀c'", () => assert.equal(truncate("a😀b😀c", 5), "a😀b😀c"));
+test("truncate('abcdef', 3, '😀') → 'ab😀'", () => assert.equal(truncate("abcdef", 3, "😀"), "ab😀"));
+
+test("loop property test: for text 'a😀b😀c😀d' and every max from 0 to 10, Array.from(result).length <= max", () => {
+  const text = "a😀b😀c😀d";
+  for (let max = 0; max <= 10; max++) {
+    const result = truncate(text, max);
+    const codePointLength = Array.from(result).length;
+    assert.ok(codePointLength <= max, `max=${max}, result="${result}", length=${codePointLength}`);
+  }
+});
+
+test("loop property test: result contains no lone surrogate", () => {
+  const text = "a😀b😀c😀d";
+  for (let max = 0; max <= 10; max++) {
+    const result = truncate(text, max);
+    const loneSurrogateRegex = /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/;
+    assert.ok(!loneSurrogateRegex.test(result), `max=${max}, result="${result}" contains lone surrogate`);
+  }
+});
+
+test("throws RangeError for max = -1", () => assert.throws(() => truncate("hello", -1), RangeError));
+test("throws RangeError for max = 1.5", () => assert.throws(() => truncate("hello", 1.5), RangeError));
+test("throws RangeError for max = NaN", () => assert.throws(() => truncate("hello", NaN), RangeError));
+test("throws RangeError for max = Infinity", () => assert.throws(() => truncate("hello", Infinity), RangeError));
+test("throws RangeError for max = '5'", () => assert.throws(() => truncate("hello", "5"), RangeError));
+
+test("truncate is exported from index.js", () => assert.equal(textkit.truncate, truncate));
diff --git a/test/wrap.test.js b/test/wrap.test.js

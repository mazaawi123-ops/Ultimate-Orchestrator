new file mode 100644
index 0000000..737bfea
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,88 @@
+from todo.cli import main
+from datetime import date
+import pytest
+
+
+def test_add_with_due_output(capsys, tmp_path):
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "t", "--due", "2026-10-01"])
+    captured = capsys.readouterr()
+    assert captured.out.strip() == "added #1: t (due 2026-10-01)"
+
+
+def test_add_without_due_output_unchanged(capsys, tmp_path):
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "t"])
+    captured = capsys.readouterr()
+    assert captured.out.strip() == "added #1: t"
+
+
+def test_list_shows_due(capsys, tmp_path):
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "t", "--due", "2026-10-01"])
+    main(["--db", str(db), "add", "u"])
+    capsys.readouterr()  # Clear previous output
+    main(["--db", str(db), "list"])
+    captured = capsys.readouterr()
+    lines = captured.out.strip().split("\n")
+    assert lines == ["[ ] #1 t (due 2026-10-01)", "[ ] #2 u"]
+
+
+def test_list_all_shows_done_with_due(capsys, tmp_path):
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "t", "--due", "2026-10-01"])
+    main(["--db", str(db), "done", "1"])
+    capsys.readouterr()  # Clear previous output
+    main(["--db", str(db), "list", "--all"])
+    captured = capsys.readouterr()
+    assert "[x] #1 t (due 2026-10-01)" in captured.out
+
+
+def test_add_invalid_due_exits_2(capsys, tmp_path):
+    db = tmp_path / "db.json"
+    bad_dates = ["2026-13-01", "tomorrow", "20261001"]
+    for bad in bad_dates:
+        with pytest.raises(SystemExit) as e:
+            main(["--db", str(db), "add", "t", "--due", bad])
+        assert e.value.code == 2
+        assert "invalid due date" in capsys.readouterr().err
+        assert not db.exists()
+
+
+def test_overdue_command(capsys, tmp_path, monkeypatch):
+    class FixedDate(date):
+        @classmethod
+        def today(cls):
+            return cls(2026, 9, 23)
+
+    monkeypatch.setattr("todo.store.date", FixedDate)
+
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "late", "--due", "2026-09-22"])
+    main(["--db", str(db), "add", "now", "--due", "2026-09-23"])
+    main(["--db", str(db), "add", "later", "--due", "2026-09-24"])
+    main(["--db", str(db), "add", "none"])
+    main(["--db", str(db), "add", "late-done", "--due", "2026-09-22"])
+    main(["--db", str(db), "done", "5"])
+
+    capsys.readouterr()  # Clear previous output
+    main(["--db", str(db), "overdue"])
+    captured = capsys.readouterr()
+    lines = captured.out.strip().split("\n")
+    assert lines == ["[ ] #1 late (due 2026-09-22)"]
+
+
+def test_overdue_empty_prints_nothing(capsys, tmp_path):
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "x"])
+    capsys.readouterr()  # Clear previous output
+    main(["--db", str(db), "overdue"])
+    captured = capsys.readouterr()
+    assert captured.out == ""
+
+
+def test_due_only_on_add(tmp_path):
+    db = tmp_path / "db.json"
+    with pytest.raises(SystemExit) as e:
+        main(["--db", str(db), "list", "--due", "2026-10-01"])
+    assert e.value.code == 2

 import json
+import re
 from pathlib import Path
+from datetime import date
+
+
+DUE_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}")
+
+
+def parse_due(s):
+    """Parse and validate a due date string in YYYY-MM-DD format.
+
+    Returns the string unchanged if valid, raises ValueError otherwise.
+    """
+    if not isinstance(s, str) or not DUE_RE.fullmatch(s):
+        raise ValueError(f"invalid due date: {s!r} (expected YYYY-MM-DD)")
+    try:
+        date.fromisoformat(s)
+    except ValueError:
+        raise ValueError(f"invalid due date: {s!r} (expected YYYY-MM-DD)") from None
+    return s
 
 
 class Store:
-    """JSON-backed todo storage. Each item: {"id": int, "title": str, "done": bool}."""
+    """JSON-backed todo storage. Each item: {"id": int, "title": str, "done": bool} plus optional "due": "YYYY-MM-DD"."""
 
     def __init__(self, path):
         self.path = Path(path)
@@ -14,9 +33,11 @@ class Store:
     def save(self):
         self.path.write_text(json.dumps(self.items, indent=2))
 
-    def add(self, title):
+    def add(self, title, due=None):
         new_id = max((i["id"] for i in self.items), default=0) + 1
         item = {"id": new_id, "title": title, "done": False}
+        if due is not None:
+            item["due"] = parse_due(due)
         self.items.append(item)
         self.save()
         return item
@@ -31,3 +52,20 @@ class Store:
 
     def list(self, include_done=False):
         return [i for i in self.items if include_done or not i["done"]]
+
+    def overdue(self, today=None):
+        today = today or date.today()
+        result = []
+        for i in self.items:
+            if i["done"]:
+                continue
+            due_str = i.get("due")
+            if not due_str:
+                continue
+            try:
+                parse_due(due_str)
+                if date.fromisoformat(due_str) < today:
+                    result.append(i)
+            except ValueError:
+                pass
+        return result

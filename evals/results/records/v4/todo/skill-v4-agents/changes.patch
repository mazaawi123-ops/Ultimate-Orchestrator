+def test_parse_due_valid():
+    assert parse_due("2026-10-01") == "2026-10-01"
+    assert parse_due("2024-02-29") == "2024-02-29"
+
+
+def test_parse_due_invalid():
+    invalid_dates = ["2026-13-01", "2026-02-30", "tomorrow", "20261001", "2026-1-5", "", "2026-10-01 ", None, 12345, "２０２６-１０-０１", "٢٠٢٦-١٠-٠١"]
+    for bad in invalid_dates:
+        with pytest.raises(ValueError, match="invalid due date"):
+            parse_due(bad)
+
+
+def test_add_invalid_due_writes_nothing(tmp_path):
+    p = tmp_path / "db.json"
+    s = Store(p)
+    with pytest.raises(ValueError):
+        s.add("a", due="2026-02-30")
+    assert s.items == []
+    assert not p.exists()
+
+
+def test_due_re_ascii_only():
+    assert DUE_RE.fullmatch("２０２６-１０-０１") is None
+    assert DUE_RE.fullmatch("2026-10-01")
+
+
+def test_overdue(tmp_path):
+    p = tmp_path / "db.json"
+    s = Store(p)
+    today = date(2026, 9, 23)
+    id_22 = s.add("due 09-22", due="2026-09-22")["id"]
+    id_23 = s.add("due 09-23", due="2026-09-23")["id"]
+    s.add("due 09-24", due="2026-09-24")
+    id_done = s.add("done 01-01", due="2026-01-01")["id"]
+    s.complete(id_done)
+    s.add("no due")
+
+    overdue_ids = [i["id"] for i in s.overdue(today=today)]
+    assert overdue_ids == [id_22]
+
+
+def test_overdue_skips_malformed_and_null_due(tmp_path):
+    p = tmp_path / "db.json"
+    p.write_text('[{"id":1,"title":"a","done":false,"due":"soon"},{"id":2,"title":"b","done":false,"due":null},{"id":3,"title":"c","done":false,"due":12345},{"id":4,"title":"d","done":false,"due":"2026-01-01"}]')
+    s = Store(p)
+    overdue_ids = [i["id"] for i in s.overdue(today=date(2026, 9, 23))]
+    assert overdue_ids == [4]
+
+
+def test_old_format_file_compat(tmp_path):
+    p = tmp_path / "db.json"
+    p.write_text('[{"id": 1, "title": "old", "done": false}, {"id": 2, "title": "old2", "done": true}]')
+    s = Store(p)
+    assert len(s.list(include_done=True)) == 2
+    assert s.overdue(today=date(2026, 9, 23)) == []
+    s.complete(1)
+    raw = json.loads(p.read_text())
+    assert all("due" not in item for item in raw)
+    new_item = s.add("new")
+    assert "due" not in new_item
+    assert new_item["id"] == 3

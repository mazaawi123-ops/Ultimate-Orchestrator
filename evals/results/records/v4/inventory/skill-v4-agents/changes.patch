+def test_import_csv_basic(tmp_path):
+    p = tmp_path / "test.csv"
+    p.write_bytes("sku,qty\nA,5\n\nB,2\n".encode("utf-8"))
+    inv = Inventory()
+    assert inv.import_csv(p) == 2
+    assert inv.level("A") == 5
+    assert inv.level("B") == 2
+

+import csv
+import re
+
+
 class InsufficientStock(Exception):
     pass
 
 
+class CsvImportError(ValueError):
+    def __init__(self, line, message):
+        self.line = line
+        super().__init__(f"line {line}: {message}")
+
+
 class Inventory:
     """In-memory stock levels keyed by SKU."""
 
@@ -17,7 +27,9 @@ class Inventory:
         if qty <= 0:
             raise ValueError("qty must be positive")
         current = self._levels.get(sku, 0)
-        # BUG: allows shipping more than we have, driving stock negative
+        if qty > current:
+            msg = f"cannot ship {qty} of {sku!r}: only {current} in stock"
+            raise InsufficientStock(msg)
         self._levels[sku] = current - qty
 
     def level(self, sku):
@@ -25,3 +37,79 @@ class Inventory:
 
     def low_stock(self, threshold=5):
         return sorted(s for s, q in self._levels.items() if q < threshold)
+
+    def import_csv(self, path) -> int:
+        """Import stock from a CSV file.
+
+        CSV must have 'sku' and 'qty' columns (case-insensitive).
+        Validates all rows before importing; raises CsvImportError
+        on any problem. Skips blank lines.
+        Returns the number of rows received.
+        """
+        with open(path, newline="", encoding="utf-8-sig") as f:
+            reader = csv.reader(f, strict=True)
+            rows = []          # validated (sku, qty) pairs
+            header = None      # (sku_index, qty_index, n_fields)
+
+            while True:
+                # physical line where this record starts
+                start = reader.line_num + 1
+                try:
+                    row = next(reader)
+                except StopIteration:
+                    break
+                except csv.Error as e:
+                    raise CsvImportError(start, f"malformed CSV: {e}")
+
+                # skip blank lines
+                if all(not field.strip() for field in row):
+                    continue
+
+                # First non-blank record is the header
+                if header is None:
+                    names = [field.strip().lower() for field in row]
+                    if "sku" not in names or "qty" not in names:
+                        msg = (f"header must contain columns 'sku' "
+                               f"and 'qty', got {row!r}")
+                        raise CsvImportError(start, msg)
+                    if names.count("sku") > 1:
+                        msg = "duplicate column 'sku' in header"
+                        raise CsvImportError(start, msg)
+                    if names.count("qty") > 1:
+                        msg = "duplicate column 'qty' in header"
+                        raise CsvImportError(start, msg)
+                    sku_index = names.index("sku")
+                    qty_index = names.index("qty")
+                    n_fields = len(row)
+                    header = (sku_index, qty_index, n_fields)
+                else:
+                    # Validate data row
+                    sku_index, qty_index, n_fields = header
+
+                    if len(row) != n_fields:
+                        msg = f"expected {n_fields} fields, got {len(row)}"
+                        raise CsvImportError(start, msg)
+
+                    sku = row[sku_index].strip()
+                    if not sku:
+                        raise CsvImportError(start, "sku is empty")
+
+                    raw = row[qty_index].strip()
+                    if not re.fullmatch(r"[+-]?[0-9]+", raw):
+                        msg = f"qty {raw!r} is not an integer"
+                        raise CsvImportError(start, msg)
+
+                    qty = int(raw)
+                    if qty <= 0:
+                        msg = f"qty must be positive, got {qty}"
+                        raise CsvImportError(start, msg)
+
+                    rows.append((sku, qty))
+
+        if header is None:
+            raise CsvImportError(1, "missing header row 'sku,qty'")
+
+        for sku, qty in rows:
+            self.receive(sku, qty)
+
+        return len(rows)

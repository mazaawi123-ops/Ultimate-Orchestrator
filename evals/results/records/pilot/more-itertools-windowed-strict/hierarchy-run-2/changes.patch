+        expected = [(None, None), (None, None)]
+        self.assertEqual(actual, expected)
+
+    def test_strict_true_with_none_in_data(self):
+        # windowed([1, 2, 3, None], 2, strict=True)
+        actual = list(mi.windowed([1, 2, 3, None], 2, strict=True))
+        expected = [(1, 2), (2, 3), (3, None)]
+        self.assertEqual(actual, expected)
+
+    def test_strict_true_with_fillvalue_match(self):
+        # windowed(['!', '!', '!'], 3, fillvalue='!', strict=True)

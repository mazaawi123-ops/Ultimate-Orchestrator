diff --git a/tests/test_more.py b/tests/test_more.py
index 3d5e8d3..9607a54 100644
--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -946,6 +946,147 @@ class WindowedTests(TestCase):
         expected = []
         self.assertEqual(actual, expected)
 
+    def test_strict_keyword_only(self):
+        # strict parameter must be keyword-only
+        with self.assertRaises(TypeError):
+            list(mi.windowed([1, 2, 3], 2, None, 1, True))
+
+    def test_strict_false_default(self):
+        # strict=False is the default, behavior should be unchanged
+        actual = list(mi.windowed([1, 2, 3, 4, 5, 6], 3, step=2, strict=False))
+        expected = [(1, 2, 3), (3, 4, 5), (5, 6, None)]
+        self.assertEqual(actual, expected)
+
+    def test_strict_true_step_variations(self):
+        # Test various step values with [1, 2, 3, 4, 5, 6, 7], n=3
+        iterable = [1, 2, 3, 4, 5, 6, 7]
+        test_cases = [
+            (
+                1,
+                [(1, 2, 3), (2, 3, 4), (3, 4, 5), (4, 5, 6), (5, 6, 7)],
+                False,
+            ),
+            (2, [(1, 2, 3), (3, 4, 5), (5, 6, 7)], False),
+            (3, [(1, 2, 3), (4, 5, 6)], True),
+            (4, [(1, 2, 3), (5, 6, 7)], False),
+            (5, [(1, 2, 3)], True),
+            (6, [(1, 2, 3)], True),
+            (7, [(1, 2, 3)], False),
+        ]
+        for step, windows, should_raise in test_cases:
+            with self.subTest(step=step):
+                it = mi.windowed(iterable, 3, step=step, strict=True)
+                result = []
+                try:
+                    for window in it:
+                        result.append(window)
+                    if should_raise:
+                        self.fail(f'Expected ValueError for step={step}')
+                except ValueError as e:
+                    if not should_raise:
+                        self.fail(
+                            f'Unexpected ValueError for step={step}: {e}'
+                        )
+                    self.assertEqual(
+                        str(e), 'windowed(): not enough items to fill a window'
+                    )
+                self.assertEqual(result, windows)
+
+    def test_strict_true_step_8_n_7(self):
+        # n=7, step=8 → [(1,2,3,4,5,6,7)], no error
+        iterable = [1, 2, 3, 4, 5, 6, 7]
+        actual = list(mi.windowed(iterable, 7, step=8, strict=True))
+        expected = [(1, 2, 3, 4, 5, 6, 7)]
+        self.assertEqual(actual, expected)
+
+    def test_strict_true_exact_fit(self):
+        # windowed([1, 2, 3, 4, 5], 3, strict=True)
+        actual = list(mi.windowed([1, 2, 3, 4, 5], 3, strict=True))
+        expected = [(1, 2, 3), (2, 3, 4), (3, 4, 5)]
+        self.assertEqual(actual, expected)
+
+    def test_strict_true_first_window_incomplete(self):
+        # windowed([1, 2, 3], 4, strict=True) → ValueError on first next()
+        it = mi.windowed([1, 2, 3], 4, strict=True)
+        with self.assertRaises(ValueError) as cm:
+            next(it)
+        self.assertEqual(
+            str(cm.exception), 'windowed(): not enough items to fill a window'
+        )
+
+    def test_strict_true_empty_iterable(self):
+        # windowed([], 3, strict=True) → []
+        actual = list(mi.windowed([], 3, strict=True))
+        expected = []
+        self.assertEqual(actual, expected)
+
+    def test_strict_true_iterator_laziness(self):
+        # windowed(iter([1, 2, 3, 4, 5, 6]), 3, step=2, strict=True) - laziness test
+        it = mi.windowed(iter([1, 2, 3, 4, 5, 6]), 3, step=2, strict=True)
+        result = []
+        result.append(next(it))  # Should yield (1,2,3)
+        result.append(next(it))  # Should yield (3,4,5)
+        with self.assertRaises(ValueError) as cm:

--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -946,6 +946,69 @@ class WindowedTests(TestCase):
         expected = []
         self.assertEqual(actual, expected)
 
+    def test_strict_complete(self):
+        # When no window needs padding, strict mode changes nothing
+        iterable = [1, 2, 3, 4, 5, 6, 7]
+        for n, step in [
+            (1, 1),
+            (3, 1),
+            (7, 1),
+            (3, 2),
+            (3, 4),
+            (3, 7),
+            (7, 8),
+        ]:
+            with self.subTest(n=n, step=step):
+                actual = list(mi.windowed(iterable, n, step=step, strict=True))
+                expected = list(mi.windowed(iterable, n, step=step))
+                self.assertEqual(actual, expected)
+
+    def test_strict_empty_seq(self):
+        self.assertEqual(list(mi.windowed([], 3, strict=True)), [])
+
+    def test_strict_too_short(self):
+        # The first window would need padding: nothing is yielded
+        it = mi.windowed(iter([1, 2]), 3, strict=True)
+        with self.assertRaises(ValueError):
+            next(it)
+
+    def test_strict_partial_final_window(self):
+        # Complete windows are yielded before the error
+        iterable = [1, 2, 3, 4, 5, 6, 7]
+        for n, step, expected in [
+            (3, 3, [(1, 2, 3), (4, 5, 6)]),  # n == step
+            (3, 5, [(1, 2, 3)]),  # off by one
+            (3, 6, [(1, 2, 3)]),  # off by two
+            (4, 2, [(1, 2, 3, 4), (3, 4, 5, 6)]),  # n > step
+            (2, 3, [(1, 2), (4, 5)]),  # step > n
+        ]:
+            with self.subTest(n=n, step=step):
+                it = mi.windowed(iterable, n, step=step, strict=True)
+                actual = [next(it) for _ in expected]
+                self.assertEqual(actual, expected)
+                with self.assertRaises(ValueError):
+                    next(it)
+
+    def test_strict_fillvalue_in_items(self):
+        # Items equal to the fillvalue are not mistaken for padding
+        iterable = [None, 1, None, None]
+        actual = list(mi.windowed(iterable, 2, step=2, strict=True))
+        self.assertEqual(actual, [(None, 1), (None, None)])
+        actual = list(
+            mi.windowed(iterable, 2, fillvalue=None, step=1, strict=True)
+        )
+        self.assertEqual(actual, [(None, 1), (1, None), (None, None)])
+
+    def test_strict_ignores_fillvalue(self):
+        actual = list(mi.windowed([1, 2, 3, 4], 2, fillvalue='!', strict=True))
+        self.assertEqual(actual, [(1, 2), (2, 3), (3, 4)])
+        with self.assertRaises(ValueError):
+            list(mi.windowed([1, 2, 3], 2, fillvalue='!', step=2, strict=True))
+
+    def test_strict_false(self):
+        actual = list(mi.windowed([1, 2, 3], 2, step=2, strict=False))
+        self.assertEqual(actual, [(1, 2), (3, None)])
+
 

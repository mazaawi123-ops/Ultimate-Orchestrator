+    def test_strict_step_uses_bounded_memory(self):
+        # Regression test: the strict path used to buffer all *step*
+        # items in a list before trimming to the last *n*, so a large
+        # step held far more than n items alive at once. Track live
+        # instances via __del__ (deterministic under CPython
+        # refcounting) to prove memory use is now O(n).
+        live = [0]
+
+        class Tracked:
+            def __init__(self, value):
+                self.value = value
+                live[0] += 1
+
+            def __del__(self):
+                live[0] -= 1
+
+        def make_iterable(count):
+            for i in range(count):
+                yield Tracked(i)
+
+        n = 2

diff --git a/tests/test_more.py b/tests/test_more.py
index 3d5e8d3..0089f7e 100644
--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -946,6 +946,90 @@ class WindowedTests(TestCase):
         expected = []
         self.assertEqual(actual, expected)
 
+    def test_strict_matches_non_strict(self):
+        # strict=True raises exactly where strict=False would yield a padded
+        # window, and yields the same windows before that point.
+        for size in range(9):
+            for n in range(1, 6):
+                for step in range(1, 7):
+                    with self.subTest(size=size, n=n, step=step):
+                        iterable = list(range(size))
+                        loose = list(mi.windowed(iterable, n, 'x', step))
+                        full = [w for w in loose if 'x' not in w]
+                        padded = len(full) < len(loose)
+                        # At most one window is padded, and it's the last
+                        self.assertEqual(loose[: len(full)], full)
+
+                        actual = []
+                        it = mi.windowed(iterable, n, 'x', step, strict=True)
+                        if padded:
+                            with self.assertRaises(ValueError):
+                                for window in it:
+                                    actual.append(window)
+                        else:
+                            actual = list(it)
+                        self.assertEqual(actual, full)
+
+    def test_strict_basic(self):
+        self.assertEqual(
+            list(mi.windowed([1, 2, 3, 4, 5], 3, strict=True)),
+            [(1, 2, 3), (2, 3, 4), (3, 4, 5)],
+        )
+        self.assertEqual(
+            list(mi.windowed([1, 2, 3, 4, 5, 6, 7], 3, step=4, strict=True)),
+            [(1, 2, 3), (5, 6, 7)],
+        )
+        # The trailing item is skipped by step, so no window needs padding
+        self.assertEqual(
+            list(mi.windowed([1, 2, 3, 4, 5, 6, 7], 3, step=7, strict=True)),
+            [(1, 2, 3)],
+        )
+        self.assertEqual(list(mi.windowed([], 3, strict=True)), [])
+
+    def test_strict_short_first_window(self):
+        it = mi.windowed(iter([1, 2, 3]), 4, strict=True)
+        with self.assertRaises(ValueError):
+            next(it)
+        # Like zip(strict=True), the error ends iteration
+        self.assertEqual(list(it), [])
+
+    def test_strict_yields_complete_windows_first(self):
+        it = mi.windowed(
+            [1, 2, 3, 4, 5, 6], 3, fillvalue='!', step=2, strict=True
+        )
+        self.assertEqual(next(it), (1, 2, 3))
+        self.assertEqual(next(it), (3, 4, 5))
+        with self.assertRaises(ValueError):
+            next(it)
+
+    def test_strict_data_equal_to_fillvalue(self):
+        # Items equal to (or identical with) fillvalue are not padding
+        for fillvalue in (None, 0, '!'):
+            with self.subTest(fillvalue=fillvalue):
+                iterable = [1, fillvalue, 2, fillvalue]
+                self.assertEqual(
+                    list(
+                        mi.windowed(
+                            iterable, 2, fillvalue, step=2, strict=True
+                        )
+                    ),
+                    [(1, fillvalue), (2, fillvalue)],
+                )
+                self.assertEqual(
+                    list(mi.windowed(iterable, 4, fillvalue, strict=True)),
+                    [(1, fillvalue, 2, fillvalue)],
+                )
+
+    def test_strict_invalid_args(self):
+        with self.assertRaises(ValueError):
+            list(mi.windowed([1, 2, 3], 0, strict=True))
+        with self.assertRaises(ValueError):
+            list(mi.windowed([1, 2, 3], 2, step=0, strict=True))
+
+    def test_strict_is_keyword_only(self):
+        with self.assertRaises(TypeError):
+            mi.windowed([1, 2, 3], 2, None, 1, True)
+
 

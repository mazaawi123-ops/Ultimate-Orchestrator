+    def test_strict_no_padding_needed(self):
+        iterable = [1, 2, 3, 4, 5, 6, 7]
+        for n, step in [
+            (3, 1),
+            (3, 2),  # n > step
+            (7, 1),  # exactly one window
+            (1, 3),  # n < step, last item lines up
+            (3, 4),  # lines up nicely
+            (3, 7),  # step past the end
+            (7, 8),  # step > len(iterable)
+        ]:
+            with self.subTest(n=n, step=step):
+                actual = list(mi.windowed(iterable, n, step=step, strict=True))
+                expected = list(mi.windowed(iterable, n, step=step))
+                self.assertEqual(actual, expected)
+
+    def test_strict_padding_needed(self):
+        iterable = [1, 2, 3, 4, 5, 6, 7]
+        for n, step, expected in [
+            (8, 1, []),  # window larger than iterable
+            (3, 3, [(1, 2, 3), (4, 5, 6)]),  # n == step
+            (4, 2, [(1, 2, 3, 4), (3, 4, 5, 6)]),  # n > step
+            (3, 5, [(1, 2, 3)]),  # off by one
+            (3, 6, [(1, 2, 3)]),  # off by two
+        ]:
+            with self.subTest(n=n, step=step):
+                it = mi.windowed(iterable, n, step=step, strict=True)
+                actual = []
+                with self.assertRaises(ValueError):
+                    for window in it:
+                        actual.append(window)
+                self.assertEqual(actual, expected)
+                # The iterator is finished after raising
+                self.assertEqual(list(it), [])
+
+    def test_strict_matches_non_strict(self):
+        # strict=True yields the unpadded prefix of the strict=False output,
+        # then raises if and only if strict=False would have padded
+        fill = object()
+        for size in range(8):
+            iterable = list(range(size))
+            for n in range(1, 9):
+                for step in range(1, 10):
+                    with self.subTest(size=size, n=n, step=step):
+                        loose = list(mi.windowed(iterable, n, fill, step))
+                        complete = [w for w in loose if w[-1] is not fill]
+                        padded = len(complete) < len(loose)
+                        actual = []
+                        try:
+                            for window in mi.windowed(
+                                iterable, n, step=step, strict=True
+                            ):
+                                actual.append(window)
+                        except ValueError:
+                            raised = True
+                        else:
+                            raised = False
+                        self.assertEqual(actual, complete)
+                        self.assertEqual(raised, padded)
+
+    def test_strict_empty_seq(self):

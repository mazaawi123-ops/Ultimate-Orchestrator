diff --git a/tests/test_more.py b/tests/test_more.py
index 3d5e8d3..c326eca 100644
--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -946,6 +946,107 @@ class WindowedTests(TestCase):
         expected = []
         self.assertEqual(actual, expected)
 
+    def test_strict_complete(self):
+        # No window needs padding, so strict mode changes nothing
+        iterable = [1, 2, 3, 4, 5, 6, 7]
+        for n, step, expected in [
+            (7, 1, [(1, 2, 3, 4, 5, 6, 7)]),  # exact fit
+            (3, 1, [(1, 2, 3), (2, 3, 4), (3, 4, 5), (4, 5, 6), (5, 6, 7)]),
+            (3, 2, [(1, 2, 3), (3, 4, 5), (5, 6, 7)]),  # n > step
+            (3, 4, [(1, 2, 3), (5, 6, 7)]),  # lines up nicely
+            (3, 7, [(1, 2, 3)]),  # remaining items are stepped over
+            (3, 10, [(1, 2, 3)]),  # step well past the end
+        ]:
+            with self.subTest(n=n, step=step):
+                actual = list(mi.windowed(iterable, n, step=step, strict=True))
+                self.assertEqual(actual, expected)
+
+    def test_strict_empty_seq(self):
+        self.assertEqual(list(mi.windowed([], 3, strict=True)), [])
+
+    def test_strict_first_window_short(self):
+        it = mi.windowed([1, 2, 3], 4, strict=True)
+        with self.assertRaises(ValueError):
+            next(it)
+
+    def test_strict_raises_after_complete_windows(self):
+        iterable = [1, 2, 3, 4, 5, 6, 7]
+        for n, step, expected in [
+            (3, 3, [(1, 2, 3), (4, 5, 6)]),  # n == step
+            (3, 5, [(1, 2, 3)]),  # off by one
+            (3, 6, [(1, 2, 3)]),  # off by two
+            (4, 2, [(1, 2, 3, 4), (3, 4, 5, 6)]),  # n > step
+            (5, 3, [(1, 2, 3, 4, 5)]),  # n > step, off by one
+        ]:
+            with self.subTest(n=n, step=step):
+                it = mi.windowed(iterable, n, step=step, strict=True)
+                # The complete windows are yielded before the error
+                actual = list(islice(it, len(expected)))
+                self.assertEqual(actual, expected)
+                with self.assertRaises(ValueError):
+                    next(it)
+
+    def test_strict_is_lazy(self):
+        # Like zip(strict=True), the error is only raised once the
+        # incomplete window is reached.
+        it = mi.windowed(count(), 3, strict=True)
+        self.assertEqual(
+            list(islice(it, 3)), [(0, 1, 2), (1, 2, 3), (2, 3, 4)]
+        )
+
+    def test_strict_fillvalue_in_data(self):
+        # Items equal to fillvalue are real items, not padding
+        for fillvalue in (None, '!'):
+            with self.subTest(fillvalue=fillvalue):
+                iterable = [1, fillvalue, fillvalue, fillvalue]
+                actual = list(
+                    mi.windowed(
+                        iterable, 2, fillvalue=fillvalue, step=2, strict=True
+                    )
+                )
+                self.assertEqual(actual, [(1, fillvalue), (fillvalue,) * 2])
+
+    def test_strict_fillvalue_ignored(self):
+        it = mi.windowed(
+            [1, 2, 3, 4, 5], 3, fillvalue='!', step=3, strict=True
+        )
+        self.assertEqual(next(it), (1, 2, 3))
+        with self.assertRaises(ValueError):
+            next(it)
+
+    def test_strict_matches_non_strict(self):
+        # strict=True yields the same windows as strict=False, except that it
+        # raises instead of yielding a window that contains padding.
+        for size in range(8):
+            for n in range(1, 6):
+                for step in range(1, 7):
+                    with self.subTest(size=size, n=n, step=step):
+                        iterable = range(size)
+                        loose = list(mi.windowed(iterable, n, step=step))
+                        complete = [w for w in loose if None not in w]
+                        padded = len(complete) < len(loose)
+                        # Only ever the last window can contain padding
+                        self.assertEqual(complete, loose[: len(complete)])
+
+                        it = mi.windowed(iterable, n, step=step, strict=True)
+                        actual = list(islice(it, len(complete)))
+                        self.assertEqual(actual, complete)
+                        if padded:
+                            with self.assertRaises(ValueError):
+                                next(it)
+                        else:
+                            self.assertEqual(list(it), [])
+
+    def test_strict_invalid_args(self):
+        with self.assertRaises(ValueError):
+            list(mi.windowed([1, 2, 3], 0, strict=True))
+        with self.assertRaises(ValueError):
+            list(mi.windowed([1, 2, 3], 2, step=0, strict=True))
+
+    def test_strict_keyword_only(self):
+        with self.assertRaises(TypeError):
+            mi.windowed([1, 2, 3], 2, None, 1, True)
+
 

+    def test_weekday_next_run(self):
+        # January 4 2010 == Monday, January 8 == Friday,
+        # January 9 == Saturday, January 10 == Sunday
+        mock_job = make_mock_job()
+        cases = [
+            # (now, expected next run)
+            ((2010, 1, 4, 8, 0), (2010, 1, 4)),  # Monday before 09:00
+            ((2010, 1, 4, 9, 0), (2010, 1, 5)),  # Monday exactly 09:00
+            ((2010, 1, 4, 10, 0), (2010, 1, 5)),  # Monday after 09:00
+            ((2010, 1, 7, 10, 0), (2010, 1, 8)),  # Thursday after 09:00
+            ((2010, 1, 8, 8, 0), (2010, 1, 8)),  # Friday before 09:00
+            ((2010, 1, 8, 10, 0), (2010, 1, 11)),  # Friday after 09:00
+            ((2010, 1, 9, 8, 0), (2010, 1, 11)),  # Saturday before 09:00
+            ((2010, 1, 9, 10, 0), (2010, 1, 11)),  # Saturday after 09:00
+            ((2010, 1, 10, 8, 0), (2010, 1, 11)),  # Sunday before 09:00
+            ((2010, 1, 10, 23, 59), (2010, 1, 11)),  # Sunday late
+        ]
+        for now, expected in cases:
+            schedule.clear()
+            with mock_datetime(*now):
+                job = every().weekday.at("09:00").do(mock_job)
+                assert job.next_run == datetime.datetime(*expected, 9, 0), now
+                assert job.unit == "days"
+
+    def test_weekday_without_at(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 8, 13, 16):  # Friday
+            job = every().weekday.do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 11, 13, 16)
+        with mock_datetime(2010, 1, 6, 13, 16):  # Wednesday
+            job = every().weekday.do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 7, 13, 16)
+
+    def test_run_weekday_never_on_weekend(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 1, 12, 0):  # Friday, January 1 2010
+            every().weekday.at("09:00").do(mock_job)
+
+        run_days = []
+        # Simulate two weeks, polling every hour
+        for day in range(2, 16):
+            for hour in range(24):
+                with mock_datetime(2010, 1, day, hour, 0):
+                    before = mock_job.call_count
+                    schedule.run_pending()
+                    if mock_job.call_count > before:
+                        run_days.append((day, hour))
+
+        assert run_days == [
+            (day, 9) for day in (4, 5, 6, 7, 8, 11, 12, 13, 14, 15)
+        ]
+        for day, _ in run_days:
+            assert datetime.date(2010, 1, day).weekday() < 5
+
+    def test_weekday_reschedules_friday_to_monday(self):

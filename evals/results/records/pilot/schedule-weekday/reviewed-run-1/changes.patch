+        # Friday 2010-01-08 16:00 Berlin == Friday 10:00 New York, after 09:00
+        # -> next run is Monday 09:00 New York == Monday 15:00 Berlin
+        with mock_datetime(2010, 1, 8, 16, 0, zone=TZ_BERLIN):
+            job = every().weekday.at("09:00", "America/New_York").do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 11, 15, 0)
+        # Friday 20:00 New York is Saturday 02:00 in Berlin. It is a weekday
+        # in the job's timezone, so it is scheduled.
+        with mock_datetime(2010, 1, 8, 12, 0, zone=TZ_BERLIN):
+            job = every().weekday.at("20:00", "America/New_York").do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 9, 2, 0)
+        # Saturday 03:00 Berlin == Friday 21:00 New York, after 20:00.
+        # Saturday and Sunday in New York are skipped: next run is
+        # Monday 20:00 New York == Tuesday 02:00 Berlin.
+        with mock_datetime(2010, 1, 9, 3, 0, zone=TZ_BERLIN):
+            job = every().weekday.at("20:00", "America/New_York").do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 12, 2, 0)

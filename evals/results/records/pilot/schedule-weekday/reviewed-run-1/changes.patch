+    def test_weekday_at_timezone(self):
+        mock_job = self.make_tz_mock_job()
+        # Local time (Berlin) is Monday 2010-01-11 01:00, but in New York it
+        # is still Sunday 2010-01-10 19:00. The weekday is judged in the
+        # job's timezone, so the next run is Monday 09:00 New York time,
+        # which is Monday 15:00 in Berlin.

+    def test_weekday_next_run(self):
+        # January 2010: 4 == Monday, 8 == Friday, 9 == Saturday, 10 == Sunday
+        cases = [
+            # (now: day, hour, minute), expected next run day
+            ((4, 8, 59), 4),  # Monday before 09:00 -> Monday
+            ((4, 9, 0), 5),  # Monday exactly 09:00 -> Tuesday
+            ((6, 12, 0), 7),  # Wednesday after 09:00 -> Thursday
+            ((7, 23, 59), 8),  # Thursday late -> Friday
+            ((8, 8, 0), 8),  # Friday before 09:00 -> Friday
+            ((8, 9, 30), 11),  # Friday after 09:00 -> Monday
+            ((9, 8, 0), 11),  # Saturday before 09:00 -> Monday
+            ((9, 12, 0), 11),  # Saturday after 09:00 -> Monday
+            ((10, 8, 0), 11),  # Sunday before 09:00 -> Monday
+            ((10, 23, 59), 11),  # Sunday late -> Monday
+        ]
+        for (day, hour, minute), expected_day in cases:
+            with self.subTest(day=day, hour=hour, minute=minute):
+                schedule.clear()
+                with mock_datetime(2010, 1, day, hour, minute):
+                    job = every().weekday.at("09:00").do(make_mock_job())
+                assert job.next_run == datetime.datetime(2010, 1, expected_day, 9, 0)
+                assert job.next_run.weekday() < 5
+
+    def test_weekday_runs_monday_to_friday_only(self):
+        mock_job = make_mock_job()
+        run_times = []
+        mock_job.side_effect = lambda: run_times.append(datetime.datetime.now())
+
+        # Wednesday 30 December 2009 (crosses a month and year boundary)
+        start = datetime.datetime(2009, 12, 30, 0, 0)
+        with mock_datetime(start.year, start.month, start.day, 0, 0):
+            every().weekday.at("09:00").do(mock_job)
+
+        # Poll every 15 minutes for three weeks
+        moment = start
+        while moment < start + datetime.timedelta(weeks=3):
+            with mock_datetime(
+                moment.year, moment.month, moment.day, moment.hour, moment.minute
+            ):
+                schedule.run_pending()
+            moment += datetime.timedelta(minutes=15)
+
+        # Every weekday in the window, exactly once, at 09:00
+        expected = [
+            start.replace(hour=9) + datetime.timedelta(days=d)
+            for d in range(21)
+            if (start + datetime.timedelta(days=d)).weekday() < 5
+        ]
+        assert len(expected) == 15
+        assert run_times == expected
+        assert all(t.weekday() < 5 for t in run_times)
+
+    def test_weekday_late_run_is_not_run_on_weekend(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 8, 8, 0):  # Friday
+            job = every().weekday.at("09:00").do(mock_job)
+        assert job.next_run == datetime.datetime(2010, 1, 8, 9, 0)
+
+        # The scheduler was not polled on Friday; the missed run is not
+        # picked up on Saturday or Sunday
+        with mock_datetime(2010, 1, 9, 10, 0):  # Saturday
+            schedule.run_pending()
+        assert mock_job.call_count == 0
+        assert job.last_run is None
+        assert job.next_run == datetime.datetime(2010, 1, 11, 9, 0)
+
+        with mock_datetime(2010, 1, 10, 10, 0):  # Sunday
+            schedule.run_pending()
+        assert mock_job.call_count == 0
+
+        with mock_datetime(2010, 1, 11, 9, 0):  # Monday
+            schedule.run_pending()
+        assert mock_job.call_count == 1
+        assert job.next_run == datetime.datetime(2010, 1, 12, 9, 0)
+

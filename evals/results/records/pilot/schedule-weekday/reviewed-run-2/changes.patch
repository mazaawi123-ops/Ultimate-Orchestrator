+    def test_weekday_until(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 8, 8, 0):  # Friday
+            every().weekday.at("09:00").until(datetime.datetime(2010, 1, 10, 12, 0)).do(
+                mock_job
+            )
+        with mock_datetime(2010, 1, 8, 9, 0):
+            schedule.run_pending()
+        # The next run (Monday) is past the deadline, so the job is cancelled
+        assert mock_job.call_count == 1
+        assert len(schedule.jobs) == 0
+
+    def test_weekday_until_after_weekend_skip(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 8, 8, 0):  # Friday
+            every().weekday.at("09:00").until(datetime.datetime(2010, 1, 10, 12, 0)).do(
+                mock_job
+            )
+        # Friday's run is missed; on Saturday it is skipped, and because the
+        # next run (Monday) is past the deadline the job is cancelled
+        with mock_datetime(2010, 1, 9, 12, 0):
+            schedule.run_pending()
+        assert mock_job.call_count == 0

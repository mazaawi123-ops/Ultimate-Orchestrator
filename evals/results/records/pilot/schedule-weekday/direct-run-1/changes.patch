+    def test_weekday_at_next_run(self):
+        # 2010-01-04 is a Monday; 2010-01-09/10 are Saturday/Sunday
+        cases = [
+            # (now: day, hour, minute), expected next run (day, hour, minute)
+            ((4, 8, 0), (4, 9, 0)),  # Monday before 09:00 -> today
+            ((4, 9, 0), (5, 9, 0)),  # Monday exactly 09:00 -> Tuesday
+            ((4, 10, 0), (5, 9, 0)),  # Monday after 09:00 -> Tuesday
+            ((7, 23, 0), (8, 9, 0)),  # Thursday evening -> Friday
+            ((8, 8, 59), (8, 9, 0)),  # Friday before 09:00 -> today
+            ((8, 9, 1), (11, 9, 0)),  # Friday after 09:00 -> Monday
+            ((9, 8, 0), (11, 9, 0)),  # Saturday morning -> Monday
+            ((9, 10, 0), (11, 9, 0)),  # Saturday after 09:00 -> Monday
+            ((10, 8, 0), (11, 9, 0)),  # Sunday morning -> Monday
+            ((10, 23, 59), (11, 9, 0)),  # Sunday night -> Monday
+        ]
+        for (day, hour, minute), (exp_day, exp_hour, exp_minute) in cases:
+            with self.subTest(now=(day, hour, minute)):
+                schedule.clear()
+                with mock_datetime(2010, 1, day, hour, minute):
+                    job = every().weekday.at("09:00").do(make_mock_job())
+                    assert job.next_run == datetime.datetime(
+                        2010, 1, exp_day, exp_hour, exp_minute
+                    )
+
+    def test_weekday_at_runs_monday_to_friday_only(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 3, 12, 0):  # Sunday
+            every().weekday.at("09:00").do(mock_job)
+
+        # Step through two full weeks (Mon 2010-01-04 to Sun 2010-01-17)
+        # in 15 minute increments and record when the job ran.
+        run_times = []
+        moment = datetime.datetime(2010, 1, 4, 0, 0)
+        while moment < datetime.datetime(2010, 1, 18, 0, 0):
+            with mock_datetime(
+                moment.year, moment.month, moment.day, moment.hour, moment.minute
+            ):
+                before = mock_job.call_count
+                schedule.run_pending()
+                if mock_job.call_count > before:
+                    run_times.append(moment)
+            moment += datetime.timedelta(minutes=15)
+
+        assert run_times == [
+            datetime.datetime(2010, 1, day, 9, 0)
+            for day in (4, 5, 6, 7, 8, 11, 12, 13, 14, 15)
+        ]
+        assert all(t.weekday() < 5 for t in run_times)
+
+    def test_weekday_rescheduled_from_friday_to_monday(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 8, 8, 0):  # Friday
+            job = every().weekday.at("09:00").do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 8, 9, 0)
+        with mock_datetime(2010, 1, 8, 9, 0, 5):
+            schedule.run_pending()
+            assert mock_job.call_count == 1
+            assert job.next_run == datetime.datetime(2010, 1, 11, 9, 0)
+
+    def test_weekday_without_at(self):
+        with mock_datetime(2010, 1, 9, 13, 30):  # Saturday
+            job = every().weekday.do(make_mock_job())
+            assert job.next_run == datetime.datetime(2010, 1, 11, 13, 30)
+        schedule.clear()
+        with mock_datetime(2010, 1, 6, 13, 30):  # Wednesday
+            job = every().weekday.do(make_mock_job())

+    def test_tz_weekday_judged_in_at_timezone(self):
+        # `.weekday` is judged in the at() timezone, not local time.
+        mock_job = self.make_tz_mock_job()
+        with mock_datetime(2024, 9, 27, 22, 0, 0):
+            # Local Berlin: Fri 2024-09-27 22:00 (CEST, UTC+2)
+            # Auckland (Pacific/Auckland): Sat 2024-09-28 06:00 NZST (not yet DST)
+            # Auckland switches to NZDT (UTC+13) on 2024-09-29 02:00.
+            # Expected next run: Auckland's Monday 09:00 (NZDT), i.e.
+            # 2024-09-29 20:00 UTC == 2024-09-29 22:00 local Berlin (CEST)
+            # -- NOT Auckland's Saturday.
+            next = every().weekday.at("09:00", "Pacific/Auckland").do(mock_job).next_run
+            assert next == datetime.datetime(2024, 9, 29, 22, 0, 0)
+            assert next.strftime("%A") == "Sunday"
+

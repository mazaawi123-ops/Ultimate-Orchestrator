+            job = every().weekday.at("09:00", "Asia/Hong_Kong").do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 11, 2, 0)
+        # Sunday 2010-01-10 23:30 Berlin is Monday 06:30 in Hong Kong, so the

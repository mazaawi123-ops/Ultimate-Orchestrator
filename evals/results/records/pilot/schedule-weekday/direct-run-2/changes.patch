+    def test_weekday_runs_monday_to_friday_only(self):
+        mock_job = make_mock_job()
+        # january 3 2010 == Sunday, january 4 2010 == Monday
+        with mock_datetime(2010, 1, 3, 8, 0):
+            job = every().weekday.at("09:00").do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 4, 9, 0)
+
+        # Walk two full weeks, checking just before and just after 09:00
+        runs = []
+        for day in range(3, 18):
+            for hour, minute in ((8, 59), (9, 1)):
+                with mock_datetime(2010, 1, day, hour, minute):
+                    before = mock_job.call_count
+                    schedule.run_pending()
+                    if mock_job.call_count > before:
+                        runs.append(datetime.datetime(2010, 1, day, hour, minute))
+
+        assert [r.weekday() for r in runs] == [0, 1, 2, 3, 4] * 2
+        assert all((r.hour, r.minute) == (9, 1) for r in runs)
+        assert mock_job.call_count == 10
+
+    def test_weekday_next_run_skips_weekend(self):
+        mock_job = make_mock_job()
+        # january 8 2010 == Friday
+        with mock_datetime(2010, 1, 8, 9, 30):
+            job = every().weekday.at("09:00").do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 11, 9, 0)
+        with mock_datetime(2010, 1, 8, 8, 30):
+            job = every().weekday.at("09:00").do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 8, 9, 0)
+        # january 9 2010 == Saturday
+        with mock_datetime(2010, 1, 9, 8, 0):
+            job = every().weekday.at("09:00").do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 11, 9, 0)
+        # Mid-week, after the time has passed: the next day
+        with mock_datetime(2010, 1, 6, 10, 0):
+            job = every().weekday.at("09:00").do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 7, 9, 0)
+
+    def test_weekday_after_friday_run_reschedules_to_monday(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 8, 8, 0):  # Friday
+            job = every().weekday.at("09:00").do(mock_job)
+        with mock_datetime(2010, 1, 8, 9, 0):
+            schedule.run_pending()
+            assert mock_job.call_count == 1
+            assert job.next_run == datetime.datetime(2010, 1, 11, 9, 0)
+
+    def test_weekday_without_at(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 8, 15, 30):  # Friday
+            job = every().weekday.do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 11, 15, 30)
+
+    def test_weekday_unit_and_interval(self):
+        assert every().weekday.unit == "days"
+        assert every().weekday.weekdays_only
+        assert not every().day.weekdays_only
+        self.assertRaises(IntervalError, lambda: every(2).weekday)
+
+    def test_weekday_cannot_combine_with_specific_day(self):
+        mock_job = make_mock_job()
+        with self.assertRaises(ScheduleValueError):
+            every().weekday.monday.do(mock_job)
+        with self.assertRaises(ScheduleValueError):
+            every().monday.weekday.do(mock_job)
+        assert schedule.jobs == []
+
+    def test_weekday_repr(self):
+        mock_job = make_mock_job("job_fun")
+        with mock_datetime(2010, 1, 8, 8, 0):
+            s = repr(every().weekday.at("09:00").do(mock_job))
+            assert s.startswith("Every 1 weekday at 09:00:00 do job_fun()")
+            s = repr(every().weekday.do(mock_job))
+            assert s.startswith("Every 1 weekday do job_fun()")
+
+    def test_weekday_at_timezone_uses_that_timezones_weekday(self):
+        mock_job = self.make_tz_mock_job()
+        # Local time is Berlin. Friday 2010-01-08 23:30 in Berlin is already
+        # Saturday 07:30 in Hong Kong (UTC+8), so the next Hong Kong weekday
+        # 09:00 is Monday 2010-01-11 09:00 HKT == Monday 02:00 Berlin.

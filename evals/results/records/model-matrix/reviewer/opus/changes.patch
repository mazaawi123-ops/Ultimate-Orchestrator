+    def test_weekday_unit(self):
+        job = every().weekday
+        assert job.unit == "days"
+        assert job.weekdays_only
+
+    def test_weekday_next_run_from_every_day_of_week(self):
+        # january 4 2010 == Monday ... january 10 2010 == Sunday
+        # (start day, hour, minute) -> expected (day of next run)
+        cases = [
+            ((4, 8, 59), 4),  # Monday before 09:00 -> today
+            ((4, 9, 0), 5),  # Monday exactly 09:00 -> tomorrow
+            ((4, 10, 0), 5),  # Monday after 09:00 -> Tuesday
+            ((5, 10, 0), 6),
+            ((6, 10, 0), 7),
+            ((7, 10, 0), 8),
+            ((8, 8, 0), 8),  # Friday before 09:00 -> today
+            ((8, 10, 0), 11),  # Friday after 09:00 -> Monday
+            ((9, 8, 0), 11),  # Saturday before 09:00 -> Monday
+            ((9, 10, 0), 11),  # Saturday after 09:00 -> Monday
+            ((10, 8, 0), 11),  # Sunday before 09:00 -> Monday
+            ((10, 23, 59), 11),  # Sunday late -> Monday
+        ]
+        for (day, hour, minute), expected_day in cases:
+            schedule.clear()
+            with mock_datetime(2010, 1, day, hour, minute):
+                job = every().weekday.at("09:00").do(make_mock_job())
+                assert job.next_run == datetime.datetime(
+                    2010, 1, expected_day, 9, 0, 0
+                ), (day, hour, minute, job.next_run)
+                assert job.next_run.weekday() < 5
+
+    def test_run_every_weekday_at_specific_time(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 4, 0, 0):  # january 4 2010 == Monday
+            every().weekday.at("09:00").do(mock_job)
+
+        # Walk through two full weeks, checking every hour
+        run_days = []
+        start = datetime.datetime(2010, 1, 4, 0, 30)
+        for hours in range(14 * 24):
+            moment = start + datetime.timedelta(hours=hours)
+            with mock_datetime(
+                moment.year, moment.month, moment.day, moment.hour, moment.minute
+            ):
+                calls_before = mock_job.call_count
+                schedule.run_pending()
+                if mock_job.call_count > calls_before:
+                    run_days.append((moment.day, moment.hour))
+
+        # Mon-Fri at the first check after 09:00, never on Sat/Sun
+        assert run_days == [
+            (day, 9) for day in (4, 5, 6, 7, 8, 11, 12, 13, 14, 15)
+        ], run_days
+        for day, _ in run_days:
+            assert datetime.date(2010, 1, day).weekday() < 5
+
+    def test_run_every_weekday_friday_to_monday(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 8, 8, 0):  # january 8 2010 == Friday
+            job = every().weekday.at("09:00").do(mock_job)
+            assert job.next_run == datetime.datetime(2010, 1, 8, 9, 0)

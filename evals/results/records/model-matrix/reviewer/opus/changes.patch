+    @property
+    def weekday(self):
+        """
+        Run the job once a day, on Monday to Friday only; it never runs
+        on a Saturday or Sunday.
+
+        When combined with :meth:`at` and a timezone, the day of the week
+        is determined in that timezone.
+        """
+        if self.interval != 1:
+            raise IntervalError(
+                "Scheduling .weekday jobs is only allowed for daily jobs. "
+                "Using .weekday on a job scheduled to run every 2 or more days "
+                "is not supported."
+            )
+        self.weekdays_only = True
+        return self.days

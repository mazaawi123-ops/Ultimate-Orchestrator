+            (4, 2, [(1, 2, 3, 4), (3, 4, 5, 6)], True),  # n > step, short
+            (3, 3, [(1, 2, 3), (4, 5, 6)], True),  # n == step
+            (3, 4, [(1, 2, 3), (5, 6, 7)], False),  # lines up nicely
+            (3, 5, [(1, 2, 3)], True),  # off by one
+            (3, 6, [(1, 2, 3)], True),  # off by two
+            (3, 7, [(1, 2, 3)], False),  # step past the end

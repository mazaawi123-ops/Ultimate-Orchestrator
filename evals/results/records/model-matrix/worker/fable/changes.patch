+    def test_strict_raises(self):
+        # The complete windows are yielded, then ValueError is raised for
+        # the window that would need fillvalue padding
+        iterable = [1, 2, 3, 4, 5, 6, 7]
+        for n, step, expected in [
+            (8, 1, []),  # n > len(iterable)
+            (3, 3, [(1, 2, 3), (4, 5, 6)]),  # n == step
+            (3, 5, [(1, 2, 3)]),  # off by one
+            (3, 6, [(1, 2, 3)]),  # off by two
+            (2, 2, [(1, 2), (3, 4), (5, 6)]),  # one item short
+        ]:
+            with self.subTest(n=n, step=step):
+                it = mi.windowed(

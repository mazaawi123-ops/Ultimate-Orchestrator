+import csv
+import re
+
+
 class InsufficientStock(Exception):
     pass
 
 
+class CsvImportError(ValueError):
+    def __init__(self, path, line, reason):
+        self.path = path
+        self.line = line
+        self.reason = reason
+        super().__init__(f"{path}: line {line}: {reason}")
+
+
 class Inventory:
     """In-memory stock levels keyed by SKU."""
 
@@ -17,7 +29,8 @@ class Inventory:
         if qty <= 0:
             raise ValueError("qty must be positive")
         current = self._levels.get(sku, 0)
-        # BUG: allows shipping more than we have, driving stock negative
+        if qty > current:
+            raise InsufficientStock(f"cannot ship {qty} of {sku!r}: only {current} in stock")
         self._levels[sku] = current - qty
 
     def level(self, sku):
@@ -25,3 +38,65 @@ class Inventory:
 
     def low_stock(self, threshold=5):
         return sorted(s for s, q in self._levels.items() if q < threshold)
+
+    def import_csv(self, path):
+        """Import stock receipts from a CSV file.
+
+        The file must have a header row ``sku,qty`` (case-insensitive,
+        whitespace around field names ignored). Blank or whitespace-only
+        lines are skipped. Each remaining row must have exactly two fields;
+        both are stripped of surrounding whitespace. ``sku`` must be
+        non-empty and free of control characters; ``qty`` must be a
+        positive integer.
+
+        All rows are validated before any of them are applied to the
+        inventory (via ``receive``), so a bad row anywhere in the file
+        leaves the inventory completely unchanged.
+
+        Raises ``CsvImportError`` (a ``ValueError`` subclass, with a
+        ``.line`` attribute giving the offending physical line number) on
+        any malformed header, row or CSV content. Returns the number of
+        data rows received.
+        """
+        # Convert path to str if it's a Path object (for consistent error messages)
+        path_str = str(path)
+
+        with open(path, newline="", encoding="utf-8-sig") as f:
+            reader = csv.reader(f)
+            rows = []            # validated (sku, qty) pairs
+            header_seen = False
+            end = 0              # reader.line_num after the previous record
+            try:
+                for row in reader:
+                    line = end + 1   # physical line where THIS record starts (1-based)
+                    end = reader.line_num
+                    if row == [] or (len(row) == 1 and row[0].strip() == ""):
+                        continue     # blank line (empty or whitespace-only)
+                    if not header_seen:
+                        if [c.strip().lower() for c in row] != ["sku", "qty"]:
+                            raise CsvImportError(path_str, line, f"expected header 'sku,qty', got {','.join(row)!r}")
+                        header_seen = True
+                        continue
+                    if len(row) != 2:
+                        raise CsvImportError(path_str, line, f"expected 2 fields (sku,qty), got {len(row)}")
+                    sku, qty_text = row[0].strip(), row[1].strip()
+                    if not sku:
+                        raise CsvImportError(path_str, line, "missing sku")
+                    if any(ord(c) < 32 or ord(c) == 127 for c in sku):
+                        raise CsvImportError(path_str, line, "sku contains control characters")
+                    if not re.fullmatch(r"[0-9]+", qty_text):
+                        raise CsvImportError(path_str, line, f"qty must be a positive integer, got {qty_text!r}")
+                    try:
+                        qty = int(qty_text)
+                    except ValueError as e:
+                        raise CsvImportError(path_str, line, f"qty must be a positive integer, got {qty_text!r}") from e
+                    if qty <= 0:
+                        raise CsvImportError(path_str, line, f"qty must be a positive integer, got {qty_text!r}")
+                    rows.append((sku, qty))
+            except csv.Error as e:
+                raise CsvImportError(path_str, end + 1, f"malformed CSV: {e}") from e
+            if not header_seen:
+                raise CsvImportError(path_str, 1, "missing header, expected 'sku,qty'")
+        for sku, qty in rows:
+            self.receive(sku, qty)
+        return len(rows)

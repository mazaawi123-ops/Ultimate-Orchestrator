+    with pytest.raises(CsvImportError) as exc_info:
+        inv.import_csv(p)
+    assert exc_info.value.line == 2
+    assert "positive integer" in str(exc_info.value)
+    assert inv.level("X") == 1
+
+
+def test_import_csv_qty_fullwidth_digits_rejected(tmp_path):
+    """Non-ASCII (fullwidth) digits in qty are rejected, not silently accepted as ints."""
+    inv = Inventory()
+    inv.receive("X", 1)
+    p = tmp_path / "x.csv"
+    content = "sku,qty\nA,５\n"
+    p.write_bytes(content.encode("utf-8"))
+    with pytest.raises(CsvImportError) as exc_info:
+        inv.import_csv(p)
+    assert exc_info.value.line == 2
+    assert "positive integer" in str(exc_info.value)
+    assert inv.level("X") == 1
+
+
+def test_import_csv_qty_huge_digit_string_rejected(tmp_path):
+    """A qty with thousands of digits raises CsvImportError with a line number, not a plain ValueError."""
+    inv = Inventory()
+    inv.receive("X", 1)
+    p = tmp_path / "x.csv"
+    content = "sku,qty\nA," + ("1" * 5000) + "\n"
+    p.write_bytes(content.encode("utf-8"))
+    with pytest.raises(CsvImportError) as exc_info:
+        inv.import_csv(p)
+    assert exc_info.value.line == 2
+    assert "positive integer" in str(exc_info.value)
+    assert inv.level("X") == 1
+
+
+def test_import_csv_non_utf8_file_raises(tmp_path):
+    """A file that is not valid UTF-8 raises UnicodeDecodeError (not silently mis-decoded)."""
+    inv = Inventory()
+    inv.receive("X", 1)
+    p = tmp_path / "x.csv"
+    content = "sku,qty\nCaf\xe9,2\n".encode("latin-1")
+    p.write_bytes(content)
+    with pytest.raises(UnicodeDecodeError):
+        inv.import_csv(p)
+    assert inv.level("X") == 1

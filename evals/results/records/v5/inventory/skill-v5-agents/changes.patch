+import pytest
+from inventory.stock import Inventory, CsvImportError
+
+
+# Success cases
+def test_import_csv_with_blanks(tmp_path):
+    """'sku,qty\\nA,5\\n\\nB,2\\nA,3\\n' → returns 3; A == 8; B == 2."""
+    inv = Inventory()
+    inv.receive("X", 1)  # setup
+    p = tmp_path / "x.csv"
+    content = "sku,qty\nA,5\n\nB,2\nA,3\n"
+    p.write_bytes(content.encode("utf-8"))
+    result = inv.import_csv(p)
+    assert result == 3
+    assert inv.level("A") == 8
+    assert inv.level("B") == 2
+    assert inv.level("X") == 1  # unchanged
+
+
+def test_import_csv_crlf(tmp_path):
+    """'sku,qty\\r\\nA,5\\r\\nB,1\\r\\n' → returns 2; A == 5; B == 1."""
+    inv = Inventory()
+    inv.receive("X", 1)  # setup
+    p = tmp_path / "x.csv"
+    content = "sku,qty\r\nA,5\r\nB,1\r\n"
+    p.write_bytes(content.encode("utf-8"))
+    result = inv.import_csv(p)
+    assert result == 2
+    assert inv.level("A") == 5
+    assert inv.level("B") == 1
+
+
+def test_import_csv_with_bom(tmp_path):
+    """BOM header → returns 1; A == 1."""
+    inv = Inventory()
+    inv.receive("X", 1)  # setup
+    p = tmp_path / "x.csv"
+    # Use utf-8-sig encoding which adds BOM, don't include BOM in content string
+    content = "sku,qty\nA,1\n"
+    p.write_bytes(content.encode("utf-8-sig"))
+    result = inv.import_csv(p)
+    assert result == 1
+    assert inv.level("A") == 1

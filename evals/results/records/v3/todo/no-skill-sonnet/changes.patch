+import json
+from datetime import date, timedelta
+
+import pytest
+
 from todo.store import Store
 
 
@@ -20,3 +25,59 @@ def test_persists(tmp_path):
     p = tmp_path / "db.json"
     Store(p).add("a")
     assert Store(p).list()[0]["title"] == "a"
+
+
+def test_add_with_due_date_round_trips(tmp_path):
+    s = Store(tmp_path / "db.json")
+    item = s.add("pay rent", due="2030-01-15")
+    assert item["due"] == "2030-01-15"
+
+    reloaded = Store(tmp_path / "db.json")
+    assert reloaded.list()[0]["due"] == "2030-01-15"
+
+
+def test_add_without_due_date_leaves_it_unset(tmp_path):
+    s = Store(tmp_path / "db.json")
+    item = s.add("no deadline")
+    assert item.get("due") is None
+    assert "due" not in item
+
+
+def test_old_format_items_without_due_key_still_load(tmp_path):
+    p = tmp_path / "db.json"
+    p.write_text(json.dumps([
+        {"id": 1, "title": "legacy item", "done": False},
+        {"id": 2, "title": "legacy done item", "done": True},
+    ]))
+
+    s = Store(p)
+    assert [i["title"] for i in s.list()] == ["legacy item"]
+    assert s.overdue() == []
+
+    # completing and re-listing still works without crashing
+    s.complete(1)
+    assert s.list() == []
+
+
+def test_add_with_invalid_due_date_raises(tmp_path):
+    s = Store(tmp_path / "db.json")
+    with pytest.raises(ValueError):
+        s.add("bad date", due="not-a-date")
+    with pytest.raises(ValueError):
+        s.add("bad calendar date", due="2024-02-30")
+
+
+def test_overdue_returns_only_open_past_due_items(tmp_path):
+    s = Store(tmp_path / "db.json")
+    today = date.today()
+    past = (today - timedelta(days=1)).isoformat()
+    future = (today + timedelta(days=1)).isoformat()
+
+    overdue_open = s.add("overdue open", due=past)
+    overdue_but_done = s.add("overdue done", due=past)
+    s.complete(overdue_but_done["id"])
+    s.add("future due", due=future)
+    s.add("no due date")
+
+    result = s.overdue()
+    assert [i["id"] for i in result] == [overdue_open["id"]]

@@ -14,9 +20,17 @@ class Store:
     def save(self):
         self.path.write_text(json.dumps(self.items, indent=2))
 
-    def add(self, title):
+    def add(self, title, due=None):
         new_id = max((i["id"] for i in self.items), default=0) + 1
         item = {"id": new_id, "title": title, "done": False}
+        if due is not None:
+            try:
+                date.fromisoformat(due)
+            except (TypeError, ValueError) as exc:
+                raise ValueError(
+                    f"invalid due date {due!r}: expected an ISO date string YYYY-MM-DD"
+                ) from exc
+            item["due"] = due
         self.items.append(item)
         self.save()
         return item
@@ -31,3 +45,21 @@ class Store:
 
     def list(self, include_done=False):
         return [i for i in self.items if include_done or not i["done"]]
+
+    def overdue(self):
+        """Open items whose due date has passed, as of today."""
+        today = date.today()
+        result = []
+        for i in self.items:
+            if i["done"]:
+                continue
+            due = i.get("due")
+            if not due:
+                continue
+            try:
+                due_date = date.fromisoformat(due)
+            except (TypeError, ValueError):
+                continue
+            if due_date < today:
+                result.append(i)
+        return result

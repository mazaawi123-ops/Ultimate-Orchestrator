 import json
+from datetime import date
 from pathlib import Path
 
 
 class Store:
-    """JSON-backed todo storage. Each item: {"id": int, "title": str, "done": bool}."""
+    """JSON-backed todo storage. Each item: {"id": int, "title": str, "done": bool}.
+
+    Items may optionally carry a "due" key: an ISO date string ("YYYY-MM-DD").
+    The key is absent on items with no due date, including all items written
+    before this field existed, so it must always be read with item.get("due").

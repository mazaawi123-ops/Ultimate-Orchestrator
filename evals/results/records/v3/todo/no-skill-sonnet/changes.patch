 # todo-cli
 Tiny stdlib-only todo CLI. Run tests with `python -m pytest -q`.
-Usage: `python -m todo.cli add "title"`, `python -m todo.cli list [--all]`, `python -m todo.cli done <id>`.
+Usage: `python -m todo.cli add "title" [--due YYYY-MM-DD]`, `python -m todo.cli list [--all]`, `python -m todo.cli done <id>`, `python -m todo.cli overdue`.
+
+Due dates are optional. `list` shows the due date next to items that have one. `overdue` lists open items whose due date is before today.
diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..0a99d77
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,68 @@
+from datetime import date, timedelta
+
+import pytest
+
+import todo.cli
+from todo.store import Store
+
+
+def test_add_with_due_stores_it(tmp_path):
+    db = tmp_path / "db.json"
+    todo.cli.main(["--db", str(db), "add", "buy milk", "--due", "2030-01-01"])
+    s = Store(db)
+    items = s.list()
+    assert len(items) == 1
+    assert items[0]["title"] == "buy milk"
+    assert items[0]["due"] == "2030-01-01"
+
+
+def test_add_without_due_still_works(tmp_path):
+    db = tmp_path / "db.json"
+    todo.cli.main(["--db", str(db), "add", "write report"])
+    s = Store(db)
+    items = s.list()
+    assert len(items) == 1
+    assert items[0]["title"] == "write report"
+    assert "due" not in items[0]
+
+
+def test_list_shows_due_suffix_and_plain_format(tmp_path, capsys):
+    db = tmp_path / "db.json"
+    todo.cli.main(["--db", str(db), "add", "with due", "--due", "2030-01-01"])
+    todo.cli.main(["--db", str(db), "add", "no due"])
+    capsys.readouterr()  # discard "added" output
+
+    todo.cli.main(["--db", str(db), "list"])
+    out = capsys.readouterr().out.splitlines()
+
+    assert out[0] == "[ ] #1 with due (due: 2030-01-01)"
+    assert out[1] == "[ ] #2 no due"
+
+
+def test_overdue_excludes_done_future_and_no_due(tmp_path, capsys):
+    db = tmp_path / "db.json"
+    past = (date.today() - timedelta(days=1)).isoformat()
+    future = (date.today() + timedelta(days=1)).isoformat()
+
+    s = Store(db)
+    overdue_open = s.add("overdue open", due=past)
+    overdue_done = s.add("overdue done", due=past)
+    s.complete(overdue_done["id"])
+    s.add("future due", due=future)
+    s.add("no due")
+
+    todo.cli.main(["--db", str(db), "overdue"])
+    out = capsys.readouterr().out.splitlines()
+
+    assert len(out) == 1
+    assert out[0] == f"[ ] #{overdue_open['id']} overdue open (due: {past})"
+
+
+def test_add_invalid_due_produces_clean_error(tmp_path, capsys):
+    db = tmp_path / "db.json"
+    with pytest.raises(SystemExit):
+        todo.cli.main(["--db", str(db), "add", "bad due", "--due", "not-a-date"])
+
+    # store should not have persisted the bad item
+    s = Store(db)
+    assert s.list() == []

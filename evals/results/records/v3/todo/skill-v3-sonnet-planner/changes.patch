diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..5ae5dfb
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,51 @@
+import json
+
+import pytest
+
+from todo.cli import main
+
+
+def test_add_with_due_and_list_shows_due(tmp_path, capsys):
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "call bank", "--due", "2026-10-01"])
+    capsys.readouterr()
+    main(["--db", str(db), "list"])
+    out = capsys.readouterr().out
+    assert "call bank (due 2026-10-01)" in out
+
+
+def test_add_without_due_prints_no_due_suffix(tmp_path, capsys):
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "no due item"])
+    capsys.readouterr()
+    main(["--db", str(db), "list"])
+    out = capsys.readouterr().out
+    assert out.strip() == "[ ] #1 no due item"
+
+
+def test_add_with_invalid_due_fails_cleanly(tmp_path, capsys):
+    db = tmp_path / "db.json"
+    with pytest.raises(SystemExit) as exc_info:
+        main(["--db", str(db), "add", "bad date", "--due", "not-a-date"])
+    assert exc_info.value.code != 0
+    err = capsys.readouterr().err + capsys.readouterr().out
+    assert not db.exists()
+
+
+def test_add_with_basic_iso_due_is_normalized_to_yyyy_mm_dd(tmp_path, capsys):
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "title", "--due", "20261001"])
+    capsys.readouterr()
+    data = json.loads(db.read_text())
+    items = data["items"] if isinstance(data, dict) and "items" in data else data
+    assert items[0]["due"] == "2026-10-01"
+
+
+def test_overdue_subcommand_lists_open_overdue_items(tmp_path, capsys):
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "past due", "--due", "2020-01-01"])
+    main(["--db", str(db), "add", "future", "--due", "2099-01-01"])
+    capsys.readouterr()
+    main(["--db", str(db), "overdue"])
+    out = capsys.readouterr().out
+    assert out.strip() == "[ ] #1 past due (due 2020-01-01)"
diff --git a/tests/test_store.py b/tests/test_store.py
index d49c6c1..16f462f 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,6 @@
+import json
+from datetime import date
+
 from todo.store import Store
 
 
@@ -20,3 +23,60 @@ def test_persists(tmp_path):
     p = tmp_path / "db.json"
     Store(p).add("a")
     assert Store(p).list()[0]["title"] == "a"
+
+
+def test_add_with_due_date(tmp_path):
+    s = Store(tmp_path / "db.json")
+    item = s.add("pay rent", due="2026-10-01")
+    assert item["due"] == "2026-10-01"
+    assert s.list()[0]["due"] == "2026-10-01"
+
+
+def test_add_without_due_has_no_due_date(tmp_path):
+    s = Store(tmp_path / "db.json")
+    item = s.add("no due")
+    assert item.get("due") is None
+
+
+def test_overdue_excludes_item_due_today(tmp_path):
+    s = Store(tmp_path / "db.json")
+    s.add("today", due="2026-09-23")
+    assert s.overdue(today=date(2026, 9, 23)) == []
+
+
+def test_overdue_includes_item_due_yesterday(tmp_path):
+    s = Store(tmp_path / "db.json")
+    item = s.add("yesterday", due="2026-09-22")
+    result = s.overdue(today=date(2026, 9, 23))
+    assert [i["id"] for i in result] == [item["id"]]
+
+
+def test_overdue_excludes_future_due_date(tmp_path):
+    s = Store(tmp_path / "db.json")
+    s.add("future", due="2026-09-24")
+    assert s.overdue(today=date(2026, 9, 23)) == []
+
+
+def test_overdue_excludes_done_items(tmp_path):
+    s = Store(tmp_path / "db.json")
+    item = s.add("past but done", due="2020-01-01")
+    s.complete(item["id"])
+    assert s.overdue(today=date(2026, 9, 23)) == []
+
+
+def test_overdue_excludes_items_with_no_due_date(tmp_path):
+    s = Store(tmp_path / "db.json")
+    s.add("no due at all")
+    assert s.overdue(today=date(2026, 9, 23)) == []
+
+
+def test_legacy_items_without_due_key_do_not_error(tmp_path):
+    p = tmp_path / "db.json"
+    p.write_text(json.dumps([{"id": 1, "title": "legacy", "done": False}]))
+    s = Store(p)
+    assert s.list()[0]["title"] == "legacy"
+    assert s.overdue(today=date(2026, 9, 23)) == []
+    item = s.add("new one")
+    assert item["id"] == 2
+    s.complete(1)
+    assert [i["id"] for i in s.list()] == [2]

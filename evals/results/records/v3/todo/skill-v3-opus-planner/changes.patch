@@ -31,3 +38,19 @@ class Store:
 
     def list(self, include_done=False):
         return [i for i in self.items if include_done or not i["done"]]
+
+    def overdue(self, today):
+        result = []
+        for i in self.items:
+            if i["done"]:
+                continue
+            due_str = i.get("due")
+            if not due_str:
+                continue
+            try:
+                due_date = date.fromisoformat(due_str)
+                if due_date < today:
+                    result.append(i)
+            except (ValueError, TypeError):
+                continue
+        return result

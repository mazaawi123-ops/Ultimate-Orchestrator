 import argparse
 import os
+import re
+from datetime import date
 from .store import Store
 
 
+def parse_due(s):
+    if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", s):
+        raise argparse.ArgumentTypeError(f"invalid date {s!r}, expected YYYY-MM-DD")
+    try:
+        date.fromisoformat(s)
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"invalid date {s!r}, expected YYYY-MM-DD")
+    return s
+
+
+def format_item(item):
+    mark = "x" if item["done"] else " "
+    result = f"[{mark}] #{item['id']} {item['title']}"
+    if item.get("due"):
+        result += f" (due {item['due']})"
+    return result
+
+
 def main(argv=None):
     p = argparse.ArgumentParser(prog="todo")
     p.add_argument("--db", default=os.environ.get("TODO_DB", "todo.json"))
     sub = p.add_subparsers(dest="cmd", required=True)
-    a = sub.add_parser("add"); a.add_argument("title")
-    d = sub.add_parser("done"); d.add_argument("id", type=int)
-    l = sub.add_parser("list"); l.add_argument("--all", action="store_true")
+    a = sub.add_parser("add")
+    a.add_argument("title")
+    a.add_argument("--due", type=parse_due, default=None)
+    d = sub.add_parser("done")
+    d.add_argument("id", type=int)
+    list_parser = sub.add_parser("list")
+    list_parser.add_argument("--all", action="store_true")
+    sub.add_parser("overdue")
     args = p.parse_args(argv)
     store = Store(args.db)
     if args.cmd == "add":
-        item = store.add(args.title)
-        print(f"added #{item['id']}: {item['title']}")
+        item = store.add(args.title, due=args.due)
+        msg = f"added #{item['id']}: {item['title']}"
+        if item.get("due"):
+            msg += f" (due {item['due']})"
+        print(msg)
     elif args.cmd == "done":
         item = store.complete(args.id)
         print(f"done #{item['id']}")
     elif args.cmd == "list":
         for i in store.list(include_done=args.all):
-            mark = "x" if i["done"] else " "
-            print(f"[{mark}] #{i['id']} {i['title']}")
+            print(format_item(i))
+    elif args.cmd == "overdue":
+        for i in store.overdue(date.today()):
+            print(format_item(i))
 
 
 if __name__ == "__main__":

+    s = Store(p)
+    s.add("old item")
+    s.add("new item", due="2026-10-01")
+    stored = Store(p).list(include_done=True)
+    assert "due" not in stored[0]
+    assert stored[1]["due"] == "2026-10-01"
+
+
+def test_overdue(tmp_path):
+    from datetime import date
+    s = Store(tmp_path / "db.json")
+    s.add("late", due="2026-09-22")
+    s.add("today", due="2026-09-23")
+    s.add("future", due="2026-09-24")
+    done_item = s.add("finished", due="2026-09-01")
+    s.complete(done_item["id"])
+    s.add("no due")
+
+    result = s.overdue(today=date(2026, 9, 23))
+    assert len(result) == 1
+    assert result[0]["title"] == "late"
+
+
+def test_overdue_skips_invalid_dates(tmp_path):
+    from datetime import date
+    p = tmp_path / "db.json"
+    import json
+    p.write_text(json.dumps([
+        {"id": 1, "title": "old", "done": False},
+        {"id": 2, "title": "n", "done": False, "due": None},
+        {"id": 3, "title": "bad", "done": False, "due": "garbage"}
+    ]))
+    s = Store(p)
+    result = s.overdue(today=date(2026, 9, 23))
+    assert result == []
+
+
+def test_overdue_on_hand_written_file_returns_only_valid_past_due(tmp_path):
+    from datetime import date
+    import json
+    p = tmp_path / "db.json"
+    p.write_text(json.dumps([
+        {"id": 1, "title": "valid past", "done": False, "due": "2000-01-01"},
+        {"id": 2, "title": "null due", "done": False, "due": None},
+        {"id": 3, "title": "garbage due", "done": False, "due": "garbage"},
+    ]))
+    result = Store(p).overdue(date(2026, 9, 23))
+    assert result == [{"id": 1, "title": "valid past", "done": False, "due": "2000-01-01"}]
+
+
+def test_done_preserves_due(tmp_path):
+    s = Store(tmp_path / "db.json")
+    item = s.add("task", due="2026-10-01")
+    s.complete(item["id"])
+    stored = Store(tmp_path / "db.json").list(include_done=True)
+    assert stored[0]["due"] == "2026-10-01"
+    assert stored[0]["done"] is True

+import json
+import pytest
+from todo.cli import main
+
+
+def test_add_with_due(tmp_path, capsys):
+    p = tmp_path / "db.json"
+    main(["--db", str(p), "add", "pay rent", "--due", "2026-10-01"])
+    captured = capsys.readouterr()
+    assert captured.out == "added #1: pay rent (due 2026-10-01)\n"
+
+    item = json.loads(p.read_text())[0]
+    assert item["id"] == 1
+    assert item["title"] == "pay rent"
+    assert item["done"] is False
+    assert item["due"] == "2026-10-01"
+
+
+def test_add_without_due(tmp_path, capsys):
+    p = tmp_path / "db.json"
+    main(["--db", str(p), "add", "buy milk"])
+    captured = capsys.readouterr()
+    assert captured.out == "added #1: buy milk\n"
+
+    item = json.loads(p.read_text())[0]
+    assert item["id"] == 1
+    assert item["title"] == "buy milk"
+    assert item["done"] is False
+    assert "due" not in item
+
+
+def test_add_invalid_due_format(tmp_path):
+    p = tmp_path / "db.json"
+    with pytest.raises(SystemExit) as exc_info:
+        main(["--db", str(p), "add", "task", "--due", "2026-13-01"])
+    assert exc_info.value.code == 2
+    assert not p.exists()
+
+
+def test_add_invalid_due_value(tmp_path):
+    p = tmp_path / "db.json"
+    with pytest.raises(SystemExit) as exc_info:
+        main(["--db", str(p), "add", "task", "--due", "2026-02-30"])
+    assert exc_info.value.code == 2
+    assert not p.exists()
+
+
+def test_add_invalid_due_formats_various(tmp_path):
+    invalid_dates = [
+        "tomorrow",
+        "2026-1-5",
+        "20261001",
+        "2026-W40-4",
+        "",
+        "٢٠٢٦-١٠-٠١",
+        "２０２６-１０-０１",
+    ]
+    for i, invalid_date in enumerate(invalid_dates):
+        p_test = tmp_path / f"db_{i}.json"
+        with pytest.raises(SystemExit) as exc_info:
+            main(["--db", str(p_test), "add", "task", "--due", invalid_date])
+        assert exc_info.value.code == 2
+        assert not p_test.exists()
+
+
+def test_list_shows_due(tmp_path, capsys):
+    p = tmp_path / "db.json"
+    main(["--db", str(p), "add", "a", "--due", "2026-10-01"])
+    main(["--db", str(p), "add", "b"])
+    capsys.readouterr()  # Clear output from add commands
+    main(["--db", str(p), "list"])
+    captured = capsys.readouterr()
+    assert captured.out == "[ ] #1 a (due 2026-10-01)\n[ ] #2 b\n"
+
+
+def test_list_all_shows_due_on_done(tmp_path, capsys):
+    p = tmp_path / "db.json"
+    main(["--db", str(p), "add", "a", "--due", "2026-10-01"])
+    main(["--db", str(p), "add", "b"])
+    main(["--db", str(p), "done", "1"])
+    capsys.readouterr()  # Clear output from previous commands
+    main(["--db", str(p), "list", "--all"])
+    captured = capsys.readouterr()
+    assert captured.out == "[x] #1 a (due 2026-10-01)\n[ ] #2 b\n"
+
+
+def test_overdue_command(tmp_path, capsys):
+    p = tmp_path / "db.json"
+    main(["--db", str(p), "add", "late", "--due", "2000-01-01"])
+    main(["--db", str(p), "add", "later", "--due", "2999-12-31"])
+    main(["--db", str(p), "add", "none"])
+    main(["--db", str(p), "add", "finished", "--due", "2000-01-02"])
+    main(["--db", str(p), "done", "4"])
+    capsys.readouterr()  # Clear output from previous commands
+    main(["--db", str(p), "overdue"])
+    captured = capsys.readouterr()
+    assert captured.out == "[ ] #1 late (due 2000-01-01)\n"
+
+
+def test_overdue_empty(tmp_path, capsys):
+    p = tmp_path / "db.json"
+    main(["--db", str(p), "overdue"])
+    captured = capsys.readouterr()
+    assert captured.out == ""
+
+
+def test_overdue_no_results(tmp_path, capsys):
+    p = tmp_path / "db.json"
+    main(["--db", str(p), "add", "future", "--due", "2999-12-31"])
+    capsys.readouterr()  # Clear output from add command
+    main(["--db", str(p), "overdue"])
+    captured = capsys.readouterr()
+    assert captured.out == ""
+
+
+def test_list_with_invalid_due_in_file(tmp_path, capsys):
+    p = tmp_path / "db.json"
+    p.write_text(json.dumps([
+        {"id": 1, "title": "old", "done": False},
+        {"id": 2, "title": "n", "done": False, "due": None},
+        {"id": 3, "title": "bad", "done": False, "due": "garbage"}
+    ]))
+    main(["--db", str(p), "list"])
+    captured = capsys.readouterr()
+    assert captured.out == "[ ] #1 old\n[ ] #2 n\n[ ] #3 bad (due garbage)\n"
+
+
+def test_overdue_and_done_on_old_file_without_due_support(tmp_path, capsys):
+    p = tmp_path / "db.json"
+    p.write_text(json.dumps([
+        {"id": 1, "title": "old", "done": False},
+        {"id": 2, "title": "old late", "done": False, "due": "2000-01-01"},
+        {"id": 3, "title": "old null", "done": False, "due": None},
+    ]))
+
+    main(["--db", str(p), "overdue"])
+    captured = capsys.readouterr()
+    assert captured.out == "[ ] #2 old late (due 2000-01-01)\n"
+
+    main(["--db", str(p), "done", "1"])
+    captured = capsys.readouterr()
+    assert captured.out == "done #1\n"
+
+    items = json.loads(p.read_text())
+    assert items[0] == {"id": 1, "title": "old", "done": True}
+    assert items[2]["due"] is None
+
+
+def test_add_new_preserves_old_items(tmp_path):
+    p = tmp_path / "db.json"
+    p.write_text(json.dumps([
+        {"id": 1, "title": "old", "done": False},
+        {"id": 2, "title": "n", "done": False, "due": None},
+        {"id": 3, "title": "bad", "done": False, "due": "garbage"}
+    ]))
+    main(["--db", str(p), "add", "new", "--due", "2000-01-01"])
+    items = json.loads(p.read_text())
+    assert "due" not in items[0]
+    assert items[1]["due"] is None
+    assert items[2]["due"] == "garbage"
+    assert items[3]["due"] == "2000-01-01"

+# AC1: ship() raises InsufficientStock when qty > level, level unchanged
+def test_ship_insufficient_stock():
+    inv = Inventory()
+    inv.receive("A", 10)
+    with pytest.raises(InsufficientStock):
+        inv.ship("A", 15)
+    assert inv.level("A") == 10  # level unchanged
+
+
+def test_ship_exact_level():
+    """qty == level should succeed and leave level at 0"""
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.ship("A", 10)
+    assert inv.level("A") == 0
+
+
+def test_ship_insufficient_on_sku_never_received():
+    """ship on sku never received (level 0) should raise InsufficientStock"""
+    inv = Inventory()
+    with pytest.raises(InsufficientStock):
+        inv.ship("A", 1)
+    assert inv.level("A") == 0  # level unchanged
+

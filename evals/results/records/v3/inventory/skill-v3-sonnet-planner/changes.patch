+    def import_csv(self, path):
+        """Bulk receive from CSV; rows already received before error are not rolled back."""
+        with open(path, 'r', newline='', encoding='utf-8-sig') as f:
+            reader = csv.reader(f)
+            try:
+                header = next(reader)
+            except StopIteration:
+                raise ValueError("line 1: missing header") from None
+
+            if header != ['sku', 'qty']:
+                raise ValueError(f"line 1: expected header 'sku,qty', got {header!r}")
+
+            for row in reader:
+                # Skip genuinely blank rows: an empty line ([]) or a line that's
+                # just whitespace with no comma (a single empty/whitespace cell).
+                if not row or (len(row) == 1 and not row[0].strip()):
+                    continue
+
+                # Check column count
+                if len(row) != 2:
+                    raise ValueError(f"line {reader.line_num}: expected 2 columns, got {len(row)}")
+
+                sku, qty_str = row
+                sku = sku.strip()
+
+                # Check sku is non-empty
+                if not sku:
+                    raise ValueError(f"line {reader.line_num}: sku cannot be empty")
+
+                # Parse and validate qty
+                try:
+                    qty = int(qty_str.strip())
+                except ValueError as e:
+                    raise ValueError(f"line {reader.line_num}: qty must be an integer") from e
+
+                # receive() will check for positive, which will raise ValueError
+                try:
+                    self.receive(sku, qty)
+                except ValueError as e:
+                    raise ValueError(f"line {reader.line_num}: {e}") from e

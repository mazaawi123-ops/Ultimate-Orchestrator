+# AC2: import_csv with blank line skipped
+def test_import_csv_basic_with_blank_line(tmp_path):
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_text("sku,qty\nA,5\n\nB,2\n")
+    inv.import_csv(str(csv_file))
+    assert inv.level("A") == 5
+    assert inv.level("B") == 2
+

--- a/inventory/stock.py
+++ b/inventory/stock.py
@@ -1,7 +1,18 @@
+import csv
+import re
+
+
 class InsufficientStock(Exception):
     pass
 
 
+class CsvImportError(ValueError):
+    def __init__(self, line, reason):
+        super().__init__(f"line {line}: {reason}")
+        self.line = line
+        self.reason = reason
+
+
 class Inventory:
     """In-memory stock levels keyed by SKU."""
 
@@ -17,7 +28,8 @@ class Inventory:
         if qty <= 0:
             raise ValueError("qty must be positive")
         current = self._levels.get(sku, 0)
-        # BUG: allows shipping more than we have, driving stock negative
+        if qty > current:
+            raise InsufficientStock(f"cannot ship {qty} of {sku!r}: only {current} in stock")
         self._levels[sku] = current - qty
 
     def level(self, sku):
@@ -25,3 +37,58 @@ class Inventory:
 
     def low_stock(self, threshold=5):
         return sorted(s for s, q in self._levels.items() if q < threshold)
+
+    def import_csv(self, path):
+        pairs = []
+        with open(path, newline="", encoding="utf-8-sig") as f:
+            reader = csv.reader(f, strict=True)
+            header_found = False
+            sku_i = None
+            qty_i = None
+
+            while True:
+                start = reader.line_num + 1
+                try:
+                    fields = next(reader)
+                except StopIteration:
+                    break
+                except csv.Error as e:
+                    raise CsvImportError(start, str(e))
+
+                # Skip blank rows
+                if all(not field.strip() for field in fields):
+                    continue
+
+                # Process header
+                if not header_found:
+                    normalized = [h.strip().lower() for h in fields]
+                    if len(normalized) != 2 or set(normalized) != {"sku", "qty"}:
+                        raise CsvImportError(start, f"expected header sku,qty, got {fields!r}")
+                    sku_i = normalized.index("sku")
+                    qty_i = normalized.index("qty")
+                    header_found = True
+                    continue
+
+                # Validate row
+                if len(fields) != 2:
+                    raise CsvImportError(start, f"expected 2 fields, got {len(fields)}")
+
+                sku = fields[sku_i].strip()
+                if not sku:
+                    raise CsvImportError(start, "missing sku")
+
+                raw = fields[qty_i].strip()
+                if not re.fullmatch(r"[+-]?[0-9]+", raw):
+                    raise CsvImportError(start, f"qty must be a whole number, got {raw!r}")
+                qty = int(raw)
+
+                if qty <= 0:
+                    raise CsvImportError(start, f"qty must be positive, got {qty}")
+
+                pairs.append((sku, qty))
+
+        # All validation passed, now receive each pair
+        for sku, qty in pairs:
+            self.receive(sku, qty)
+
+        return len(pairs)

+import pytest
+from inventory.stock import Inventory, CsvImportError
+
+
+def test_import_csv_basic(tmp_path):
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_bytes(b"sku,qty\nA,5\n\nB,2\n")
+    result = inv.import_csv(str(csv_file))
+    assert result == 2
+    assert inv.level("A") == 5
+    assert inv.level("B") == 2
+
+
+def test_import_csv_crlf(tmp_path):
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_bytes(b"sku,qty\r\nA,5\r\n\r\nB,2\r\n")
+    result = inv.import_csv(str(csv_file))
+    assert result == 2
+    assert inv.level("A") == 5
+    assert inv.level("B") == 2
+
+
+def test_import_csv_bom(tmp_path):
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_bytes(b"\xef\xbb\xbfsku,qty\nA,5\n")
+    result = inv.import_csv(str(csv_file))
+    assert result == 1
+    assert inv.level("A") == 5
+
+
+def test_import_csv_reordered_case_spaces(tmp_path):
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_bytes(b"Qty , SKU\n7, A\n")
+    result = inv.import_csv(str(csv_file))
+    assert result == 1
+    assert inv.level("A") == 7
+
+
+def test_import_csv_skip_blank_lines(tmp_path):
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_bytes(b"sku,qty\n , \nA,2\n,\n   \n")
+    result = inv.import_csv(str(csv_file))
+    assert result == 1
+    assert inv.level("A") == 2
+
+
+def test_import_csv_blank_before_header(tmp_path):
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_bytes(b"\n\nsku,qty\nA,1\n")
+    result = inv.import_csv(str(csv_file))
+    assert result == 1
+    assert inv.level("A") == 1
+
+
+def test_import_csv_duplicate_sku(tmp_path):
+    inv = Inventory()
+    csv_file = tmp_path / "test.csv"
+    csv_file.write_bytes(b"sku,qty\nA,2\nA,3\n")
+    result = inv.import_csv(str(csv_file))
+    assert result == 2
+    assert inv.level("A") == 5
+
+

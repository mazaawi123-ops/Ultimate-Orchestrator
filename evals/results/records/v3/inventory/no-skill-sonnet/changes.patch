@@ -1,3 +1,6 @@
+import csv
+
+
 class InsufficientStock(Exception):
     pass
 
@@ -17,7 +20,10 @@ class Inventory:
         if qty <= 0:
             raise ValueError("qty must be positive")
         current = self._levels.get(sku, 0)
-        # BUG: allows shipping more than we have, driving stock negative
+        if qty > current:
+            raise InsufficientStock(
+                f"cannot ship {qty} of {sku!r}: only {current} in stock"
+            )
         self._levels[sku] = current - qty
 
     def level(self, sku):
@@ -25,3 +31,43 @@ class Inventory:
 
     def low_stock(self, threshold=5):
         return sorted(s for s, q in self._levels.items() if q < threshold)
+
+    def import_csv(self, path):
+        """Read a CSV with columns sku,qty and receive() each row.
+
+        Blank lines are skipped. Any row that can't be applied raises a
+        ValueError naming the 1-indexed line number in the file.
+        """
+        with open(path, newline="") as f:
+            reader = csv.reader(f)
+            try:
+                header = next(reader)
+            except StopIteration:
+                return
+            for line_no, row in enumerate(reader, start=2):
+                if not row or all(cell.strip() == "" for cell in row):
+                    continue
+                if len(row) != len(header):
+                    raise ValueError(
+                        f"import_csv: line {line_no}: expected "
+                        f"{len(header)} columns, got {len(row)}: {row!r}"
+                    )
+                sku, qty_raw = row
+                sku = sku.strip()
+                if not sku:
+                    raise ValueError(
+                        f"import_csv: line {line_no}: missing sku"
+                    )
+                try:
+                    qty = int(qty_raw.strip())
+                except ValueError:
+                    raise ValueError(
+                        f"import_csv: line {line_no}: invalid qty "
+                        f"{qty_raw!r}"
+                    ) from None
+                try:
+                    self.receive(sku, qty)
+                except ValueError as exc:
+                    raise ValueError(
+                        f"import_csv: line {line_no}: {exc}"
+                    ) from None
diff --git a/tests/test_stock.py b/tests/test_stock.py

--- a/tests/test_stock.py
+++ b/tests/test_stock.py
@@ -1,5 +1,5 @@
 import pytest
-from inventory.stock import Inventory
+from inventory.stock import Inventory, InsufficientStock
 
 
 def test_receive_and_level():
@@ -26,3 +26,96 @@ def test_rejects_nonpositive():
     inv = Inventory()
     with pytest.raises(ValueError):
         inv.receive("A", 0)
+
+
+def test_ship_more_than_stock_raises_insufficient_stock():
+    inv = Inventory()
+    inv.receive("A", 5)
+    with pytest.raises(InsufficientStock):
+        inv.ship("A", 6)
+    assert inv.level("A") == 5
+
+
+def test_ship_exact_stock_allowed():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.ship("A", 5)
+    assert inv.level("A") == 0
+
+
+def test_ship_from_unknown_sku_raises_insufficient_stock():
+    inv = Inventory()
+    with pytest.raises(InsufficientStock):
+        inv.ship("UNKNOWN", 1)
+    assert inv.level("UNKNOWN") == 0
+
+
+def test_import_csv_receives_each_row(tmp_path):
+    csv_file = tmp_path / "stock.csv"
+    csv_file.write_text("sku,qty\nA,10\nB,5\nA,3\n")
+
+    inv = Inventory()
+    inv.import_csv(str(csv_file))
+
+    assert inv.level("A") == 13
+    assert inv.level("B") == 5
+
+
+def test_import_csv_skips_blank_lines(tmp_path):
+    csv_file = tmp_path / "stock.csv"
+    csv_file.write_text("sku,qty\nA,10\n\n\nB,5\n")
+
+    inv = Inventory()
+    inv.import_csv(str(csv_file))
+
+    assert inv.level("A") == 10
+    assert inv.level("B") == 5
+
+
+def test_import_csv_empty_file_is_noop(tmp_path):
+    csv_file = tmp_path / "stock.csv"
+    csv_file.write_text("")
+
+    inv = Inventory()
+    inv.import_csv(str(csv_file))
+
+    assert inv.level("A") == 0
+
+
+def test_import_csv_bad_qty_names_line_number(tmp_path):
+    csv_file = tmp_path / "stock.csv"
+    csv_file.write_text("sku,qty\nA,10\nB,not-a-number\n")
+
+    inv = Inventory()
+    with pytest.raises(ValueError, match="line 3"):
+        inv.import_csv(str(csv_file))
+
+    # row before the bad one was already applied
+    assert inv.level("A") == 10
+
+
+def test_import_csv_missing_sku_names_line_number(tmp_path):
+    csv_file = tmp_path / "stock.csv"
+    csv_file.write_text("sku,qty\n,10\n")
+
+    inv = Inventory()
+    with pytest.raises(ValueError, match="line 2"):
+        inv.import_csv(str(csv_file))
+
+
+def test_import_csv_wrong_column_count_names_line_number(tmp_path):

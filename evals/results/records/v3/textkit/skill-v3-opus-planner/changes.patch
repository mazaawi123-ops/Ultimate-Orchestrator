--- /dev/null
+++ b/src/truncate.js
@@ -0,0 +1,20 @@
+function isHigh(c) {
+  return 0xD800 <= c && c <= 0xDBFF;
+}
+
+function isLow(c) {
+  return 0xDC00 <= c && c <= 0xDFFF;
+}
+
+// Truncate text to at most max UTF-16 code units, including ellipsis.
+export function truncate(text, max, ellipsis = "…") {
+  if (!Number.isInteger(max) || max < 0) throw new RangeError("max must be a non-negative integer");
+  const s = String(text), e = String(ellipsis);
+  if (s.length <= max) return s;
+  // if the ellipsis itself doesn't fit, cut the text to max with no ellipsis
+  let keep = e.length <= max ? max - e.length : max;
+  const suffix = e.length <= max ? e : "";
+  // back off one unit if the cut would split a surrogate pair:
+  if (keep > 0 && isHigh(s.charCodeAt(keep - 1)) && isLow(s.charCodeAt(keep))) keep--;
+  return s.slice(0, keep) + suffix;
+}

@@ -5,3 +5,91 @@ import { wrap } from "../src/wrap.js";
 test("wraps at width", () => {
   assert.equal(wrap("aaa bbb ccc ddd", 7), "aaa bbb\nccc ddd");
 });
+
+test("hard-breaks long word into chunks", () => {
+  assert.equal(wrap("abcdefghij", 3), "abc\ndef\nghi\nj");
+});
+
+test("hard-breaks word exactly at width boundary", () => {
+  assert.equal(wrap("abcdef", 3), "abc\ndef");
+});
+
+test("word exactly at width is not broken", () => {
+  assert.equal(wrap("abcd ef", 4), "abcd\nef");
+});
+
+test("hard-breaks word longer than width by 1", () => {
+  assert.equal(wrap("abcde", 4), "abcd\ne");
+});
+
+test("last chunk of broken word joins with next word", () => {
+  assert.equal(wrap("aa bbbbbbbbbb c", 4), "aa\nbbbb\nbbbb\nbb c");
+});
+
+test("long word starts on new line even with room on current line", () => {
+  assert.equal(wrap("a bcdef", 4), "a\nbcde\nf");
+});
+
+test("emoji wrapping", () => {
+  assert.equal(wrap("😀😀😀", 3), "😀\n😀\n😀");
+});
+
+test("emoji with regular text", () => {
+  assert.equal(wrap("a😀b", 2), "a\n😀\nb");
+});
+
+test("width-1 exception with astral char", () => {
+  assert.equal(wrap("😀", 1), "😀");
+});
+
+test("width-1 with regular char then emoji", () => {
+  assert.equal(wrap("x😀", 1), "x\n😀");
+});
+
+test("empty string", () => {
+  assert.equal(wrap("", 5), "");
+});
+
+test("default width", () => {
+  assert.equal(wrap("abc"), "abc");
+});
+
+test("width validation: width 0 throws", () => {
+  assert.throws(() => wrap("abc", 0), RangeError);
+});
+
+test("width validation: negative width throws", () => {
+  assert.throws(() => wrap("abc", -1), RangeError);
+});
+
+test("width validation: non-integer width throws", () => {
+  assert.throws(() => wrap("abc", 1.5), RangeError);
+});
+
+test("width validation: NaN throws", () => {
+  assert.throws(() => wrap("abc", NaN), RangeError);
+});
+
+test("property: no line exceeds width, all lines well-formed", () => {
+  const text = "the quick brownfoxjumpedoverthelazydog and 😀😀😀😀 ok";
+  for (let width = 2; width <= 10; width++) {
+    const result = wrap(text, width);
+    const lines = result.split("\n");
+    // Every line has length <= width
+    for (const line of lines) {
+      assert(line.length <= width, `Line "${line}" exceeds width ${width} (length ${line.length})`);
+    }
+    // No line is empty
+    for (const line of lines) {
+      assert(line.length > 0, `Empty line found with width ${width}`);
+    }
+    // Each line is well-formed (valid UTF-16)
+    for (const line of lines) {
+      assert(line.isWellFormed(), `Line "${line}" is not well-formed`);
+    }
+    // Nothing lost
+    const withoutWhitespace = result.replace(/\s+/g, "");
+    const inputWithoutWhitespace = text.replace(/\s+/g, "");
+    assert.equal(withoutWhitespace, inputWithoutWhitespace, `Content mismatch for width ${width}`);
+  }
+});

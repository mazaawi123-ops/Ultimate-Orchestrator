+}
+
+function isLow(c) {
+  return 0xDC00 <= c && c <= 0xDFFF;
+}
+
+// Hard-wrap text at `width` columns, breaking on spaces; hard-breaks long words.
 export function wrap(text, width = 80) {
+  if (!Number.isInteger(width) || width < 1) throw new RangeError("width must be a positive integer");
+
   const words = String(text).split(/\s+/).filter(Boolean);
   const lines = [];
   let line = "";
   for (const w of words) {
+    if (w.length > width) {
+      if (line) lines.push(line);
+      let rest = w;
+      while (rest.length > width) {
+        let k = width;
+        if (isHigh(rest.charCodeAt(k - 1)) && isLow(rest.charCodeAt(k))) k--;
+        if (k === 0) k = 2;
+        lines.push(rest.slice(0, k));
+        rest = rest.slice(k);
+      }
+      line = rest;
+      continue;
+    }
+
     if ((line + " " + w).trim().length > width && line) {
       lines.push(line);
       line = w;
diff --git a/test/truncate.test.js b/test/truncate.test.js
new file mode 100644
index 0000000..8cedd3c
--- /dev/null
+++ b/test/truncate.test.js
@@ -0,0 +1,47 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { truncate } from "../src/truncate.js";
+
+test("fits unchanged", () => assert.equal(truncate("hello world", 20), "hello world"));
+test("fits exactly", () => assert.equal(truncate("hello world", 11), "hello world"));
+test("basic truncate", () => assert.equal(truncate("hello world", 8), "hello w…"));
+test("truncate with custom ellipsis", () => assert.equal(truncate("hello world", 8, "..."), "hello..."));
+test("truncate with empty ellipsis", () => assert.equal(truncate("hello world", 5, ""), "hello"));
+test("truncate to single char", () => assert.equal(truncate("hello", 1), "…"));
+test("truncate to zero", () => assert.equal(truncate("hello", 0), ""));
+test("empty string", () => assert.equal(truncate("", 0), ""));
+test("ellipsis longer than max", () => assert.equal(truncate("hello world", 2, "..."), "he"));
+test("emoji handling", () => assert.equal(truncate("ab😀cd", 4), "ab…"));
+test("emoji fit", () => assert.equal(truncate("ab😀cd", 5), "ab😀…"));
+test("multiple emojis", () => assert.equal(truncate("😀😀😀", 4), "😀…"));
+test("emoji with long ellipsis", () => assert.equal(truncate("😀x", 1, "..."), ""));
+test("astral ellipsis", () => assert.equal(truncate("abcdef", 4, "🔚"), "ab🔚"));
+test("coerce to string", () => assert.equal(truncate(12345, 3), "12…"));
+test("re-export from index", () => {
+  return import("../src/index.js").then(mod => {
+    assert.equal(mod.truncate("hello world", 8), "hello w…");
+  });
+});
+test("no lone surrogates", () => {
+  const text = "a😀b😀c";
+  for (let max = 0; max <= 8; max++) {
+    const result = truncate(text, max);
+    assert(result.length <= max, `result length ${result.length} exceeds max ${max}`);
+    // Check that result has no lone surrogates
+    assert(result.isWellFormed(), `result at max=${max} is not well-formed: ${JSON.stringify(result)}`);
+  }
+});
+
+// Error cases
+test("negative max throws RangeError", () => {
+  assert.throws(() => truncate("hello", -1), RangeError);
+});
+test("non-integer max throws RangeError", () => {
+  assert.throws(() => truncate("hello", 2.5), RangeError);
+});
+test("NaN max throws RangeError", () => {
+  assert.throws(() => truncate("hello", NaN), RangeError);
+});
+test("missing max throws RangeError", () => {
+  assert.throws(() => truncate("hello"), RangeError);
+});
diff --git a/test/wrap.test.js b/test/wrap.test.js

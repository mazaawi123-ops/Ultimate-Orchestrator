@@ -5,3 +5,40 @@ import { wrap } from "../src/wrap.js";
 test("wraps at width", () => {
   assert.equal(wrap("aaa bbb ccc ddd", 7), "aaa bbb\nccc ddd");
 });
+
+test("hard-breaks a single word longer than width into width-sized chunks", () => {
+  assert.equal(wrap("aaaaaaaaaa", 5), "aaaaa\naaaaa");
+});
+
+test("hard-breaks a long word surrounded by normal short words", () => {
+  const result = wrap("hi there supercalifragilisticexpialidocious yo done", 7);
+  for (const l of result.split("\n")) {
+    assert.ok(l.length <= 7, `line "${l}" exceeds width`);
+  }
+});
+
+test("evenly-divisible long word produces no dangling empty line", () => {
+  const word = "a".repeat(20);
+  const result = wrap(word, 5);
+  const lines = result.split("\n");
+  assert.ok(lines.every((l) => l.length > 0), "output contains an empty line");
+  assert.equal(lines.length, word.length / 5);
+});
+
+test("invariant: no output line ever exceeds width", () => {
+  const samples = [
+    ["aaa bbb ccc ddd", 7],
+    ["aaaaaaaaaa", 5],
+    ["short words here", 100],
+    ["supercalifragilisticexpialidocious", 10],
+    ["a b supercalifragilisticexpialidocious c d", 6],
+    ["", 5],
+    ["one", 1],
+  ];
+  for (const [text, width] of samples) {
+    const lines = wrap(text, width).split("\n");
+    for (const l of lines) {
+      assert.ok(l.length <= width, `wrap(${JSON.stringify(text)}, ${width}) produced line "${l}" (${l.length} > ${width})`);
+    }
+  }
+});

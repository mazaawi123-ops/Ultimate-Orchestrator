@@ -0,0 +1,42 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { truncate } from "../src/truncate.js";
+
+test("text shorter than max is returned unchanged", () => {
+  assert.equal(truncate("hello", 10), "hello");
+});
+
+test("text longer than max uses default ellipsis", () => {
+  const result = truncate("hello world", 8);
+  assert.equal(result, "hello w…");
+  assert.equal([...result].length, 8);
+});
+
+test("custom ellipsis string", () => {
+  const result = truncate("hello world", 8, "...");
+  assert.equal(result, "hello...");
+  assert.equal([...result].length, 8);
+});
+
+test("does not split an astral character across the cut boundary", () => {
+  const result = truncate("ab😀cd", 4);
+  assert.equal([...result].length, 4);
+  // no lone/broken surrogate: round-tripping through code points is lossless
+  assert.equal([...result].join(""), result);
+  assert.doesNotMatch(result, /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/);
+});
+
+test("max = 0 returns empty string", () => {
+  assert.equal(truncate("hello", 0), "");
+});
+
+test("max smaller than ellipsis length truncates the ellipsis itself", () => {
+  const result = truncate("hello world", 1, "...");
+  assert.equal(result, ".");
+  assert.equal([...result].length, 1);
+});
+
+test("does not throw on empty string input", () => {
+  assert.doesNotThrow(() => truncate("", 5));
+  assert.equal(truncate("", 5), "");
+});
diff --git a/test/wrap.test.js b/test/wrap.test.js

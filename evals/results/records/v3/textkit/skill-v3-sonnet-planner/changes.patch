+++ b/src/truncate.js
@@ -0,0 +1,13 @@
+export function truncate(text, max, ellipsis = "…") {
+  const str = String(text);
+  const chars = Array.from(str);           // code-point aware split
+  if (chars.length <= max) return str;
+
+  const ellipsisChars = Array.from(String(ellipsis));
+  if (max <= 0) return "";
+  if (ellipsisChars.length >= max) {
+    return ellipsisChars.slice(0, max).join("");
+  }
+  const keep = max - ellipsisChars.length;
+  return chars.slice(0, keep).join("") + ellipsisChars.join("");
+}

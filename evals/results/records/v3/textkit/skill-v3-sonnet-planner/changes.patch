-    if ((line + " " + w).trim().length > width && line) {
+
+  for (const word of words) {
+    const candidate = (line + " " + word).trim();
+    if (candidate.length > w && line) {
       lines.push(line);
-      line = w;
+      line = "";
+    }
+    if (word.length > w) {
+      let chunk = "";
+      for (const cp of Array.from(word)) {
+        if (chunk.length + cp.length > w && chunk) {
+          lines.push(chunk);
+          chunk = cp;
+        } else {
+          chunk += cp;
+        }
+      }
+      line = chunk;
     } else {

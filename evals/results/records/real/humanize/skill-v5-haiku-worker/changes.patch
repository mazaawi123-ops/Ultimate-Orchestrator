+def _roundtrip_kwargs_list() -> list[dict[str, object]]:
+    return [{}, {"binary": True}, {"gnu": True}]
+
+
+def _roundtrip_tolerance(s: str, kwargs: dict[str, object]) -> int | float:
+    """Compute the max allowed |parse_size(naturalsize(n, **kwargs)) - n|.
+
+    Tolerance is derived from the suffix actually present in `s`: exact (0)
+    for plain bytes, else 0.05 * base**exp where exp/base come from the
+    suffix's position in `humanize.filesize.suffixes[mode]`.
+    """
+    if kwargs.get("gnu"):
+        mode, base = "gnu", 1024
+    elif kwargs.get("binary"):
+        mode, base = "binary", 1024
+    else:
+        mode, base = "decimal", 1000
+
+    suffix_list = humanize.filesize.suffixes[mode]
+    # Longest suffix first so e.g. "QiB" is matched before a shorter false match.
+    for i, suffix in sorted(
+        enumerate(suffix_list), key=lambda p: -len(p[1])
+    ):
+        if s.endswith(suffix):
+            exp = i + 1
+            return 0.05 * base**exp
+
+    # No multiplier suffix matched: this is a plain-bytes string
+    # ("Byte"/"Bytes" or gnu's bare "B"), which is always exact.
+    return 0
+
+
+def _roundtrip_n_values() -> list[int]:
+    values = set(range(2100))
+    for base in (1000, 1024):
+        for k in range(1, 11):
+            values.update({base**k - 1, base**k, base**k + 1})
+    values.update({999999, 1048575, 2**53 + 1, 2**64 - 1})
+    values |= {-v for v in values}
+    return sorted(values)
+
+
<email>("kwargs", _roundtrip_kwargs_list())
+def test_parse_size_roundtrip_tolerance(kwargs: dict[str, object]) -> None:
+    """parse_size(naturalsize(n)) must land within the suffix's rounding tolerance."""
+    for n in _roundtrip_n_values():
+        s = humanize.naturalsize(n, **kwargs)
+        parsed = humanize.parse_size(s)
+        tol = _roundtrip_tolerance(s, kwargs)
+        assert abs(parsed - n) <= tol, (n, kwargs, s, parsed, tol)
+
+

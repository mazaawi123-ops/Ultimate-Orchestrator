+_PARSE_SIZE_RE = re.compile(
+    r"\s*([+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]{1,3})?)\s*([A-Za-z]+)\s*",
+    re.ASCII,
+)
+
+# Build unit -> multiplier mapping for parse_size
+_UNITS = {}
+_UNITS["B"] = 1
+_UNITS["Byte"] = 1
+_UNITS["Bytes"] = 1
+for i, suffix in enumerate(suffixes["decimal"]):
+    _UNITS[suffix] = 1000 ** (i + 1)
+for i, suffix in enumerate(suffixes["binary"]):
+    _UNITS[suffix] = 1024 ** (i + 1)
+for i, letter in enumerate(suffixes["gnu"]):
+    _UNITS[letter] = 1024 ** (i + 1)
+
+
+def parse_size(text: str) -> int:
+    """Parse a human-readable filesize string into bytes.
+
+    This is the inverse of `naturalsize`, accepting the same suffixes in their
+    original (English) forms. Supports decimal (kB, MB, ...), binary (KiB, MiB, ...),
+    and GNU-style (K, M, ...) suffixes. Units are case-sensitive.
+
+    `naturalsize` output produced under an activated non-English locale (e.g.
+    French "1.0 Ko", "300 octets") is not understood by this function and
+    raises `ValueError`; only the original English suffixes are accepted.
+
+    Examples:
+        ```pycon
+        >>> parse_size("1.0 kB")
+        1000
+        >>> parse_size("2.9 KiB")
+        2970
+        >>> parse_size("300 Bytes")
+        300
+        >>> parse_size("1.0 MB")
+        1000000
+
+        ```
+
+    Args:
+        text (str): The human-readable filesize string to parse.
+
+    Returns:
+        int: The number of bytes, rounded to the nearest whole number.
+
+    Raises:
+        ValueError: If the string cannot be parsed or contains an unknown unit.
+    """
+    if not isinstance(text, str):
+        msg = f"could not parse size: {text!r}"
+        raise ValueError(msg)
+
+    match = _PARSE_SIZE_RE.fullmatch(text)
+    if not match:
+        msg = f"could not parse size: {text!r}"
+        raise ValueError(msg)
+
+    number_str, unit = match.groups()
+
+    if unit not in _UNITS:
+        msg = f"could not parse size: {text!r}"
+        raise ValueError(msg)
+
+    multiplier = _UNITS[unit]
+
+    from fractions import Fraction
+
+    try:
+        value = Fraction(number_str)
+    except ValueError:
+        msg = f"could not parse size: {text!r}"
+        raise ValueError(msg) from None
+
+    result = round(value * multiplier)
+    return int(result)
+
 
 def naturalsize(
     value: float | str,

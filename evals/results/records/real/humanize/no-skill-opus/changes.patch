+def test_parse_size_round_trip(value: int, binary: bool, gnu: bool) -> None:
+    base = 1024 if (binary or gnu) else 1000
+    text = humanize.naturalsize(value, binary, gnu)
+    result = humanize.parse_size(text)
+
+    if abs(value) < base:
+        assert result == value, text
+        return
+
+    # One display unit, e.g. 1000 for "kB": the multiplier of the suffix used
+    unit = humanize.parse_size("1 " + text.lstrip("-+0123456789. "))
+    assert unit >= base
+    # "%.1f" shows one decimal place, so it is off by at most half of 0.1 unit
+    assert abs(result - value) <= unit // 20 + 1, text
+
+    if value in {base**k for k in range(11)}:
+        assert result == value, text

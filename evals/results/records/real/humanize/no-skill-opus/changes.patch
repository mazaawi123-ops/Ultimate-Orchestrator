     space = "" if gnu else " "
     ret: str = format % (bytes_ / (base**exp)) + space + _(suffix[exp - 1])
     return ret
+
+
+# Multipliers for every unit `naturalsize` can emit, derived from `suffixes`.
+# "Byte"/"Bytes" are matched case-insensitively in `parse_size` itself.
+_unit_multipliers: dict[str, int] = {
+    "B": 1,
+    **{
+        suffix: base**exp
+        for family, base in (("decimal", 1000), ("binary", 1024), ("gnu", 1024))
+        for exp, suffix in enumerate(suffixes[family], start=1)
+    },
+}
+
+# Largest accepted absolute exponent: a huge one (e.g. "1e999999999") would
+# make the exact Fraction arithmetic take practically forever.
+_MAX_EXPONENT = 100
+
+# Optional sign, a number with optional fraction and exponent (ASCII digits
+# only), optional whitespace, then an optional alphabetic unit.
+_SIZE_PATTERN = (
+    r"\s*"
+    r"(?P<mantissa>[+-]?(?:[0-9]+\.?[0-9]*|\.[0-9]+))"
+    r"(?:[eE](?P<exponent>[+-]?[0-9]+))?"
+    r"\s*"
+    r"(?P<unit>[A-Za-z]*)"
+    r"\s*"
+)
+
+
+def parse_size(text: str) -> int:
+    """Parse a human-readable filesize (e.g. 10 kB) into a number of bytes.
+
+    This is the inverse of `naturalsize`: decimal (kB, MB), binary (KiB, MiB)
+    and GNU-style (K, M) suffixes are understood, as well as B, Byte and Bytes.
+    A bare number is taken as a number of bytes. Suffixes are case-sensitive
+    and must be written exactly as `naturalsize` writes them (so "KB", "kb"
+    and "kiB" are rejected), except for Byte and Bytes, which may be in any
+    case. Only the untranslated (English) output of `naturalsize` is
+    supported.
+
+    The number is parsed exactly (no floating point) and the result is rounded
+    to the nearest integer, with halves rounded away from zero.
+
+    Examples:
+        ```pycon
+        >>> parse_size("3.0 MB")
+        3000000
+        >>> parse_size("300B")
+        300
+        >>> parse_size("2.9K")
+        2970
+        >>> parse_size("2.930K")
+        3000
+        >>> parse_size("2.9 KiB")
+        2970
+        >>> parse_size("10.0 RB")
+        10000000000000000000000000000
+        >>> parse_size("30000.0 QB") == 10**34 * 3
+        True
+        >>> parse_size("-4.0 KiB")
+        -4096
+        >>> parse_size("1 Byte")
+        1
+        >>> parse_size("1024")
+        1024
+
+        ```
+
+    Args:
+        text (str): Filesize to parse, such as the output of `naturalsize`.
+
+    Returns:
+        int: Number of bytes, rounded to the nearest integer.
+
+    Raises:
+        TypeError: If `text` is not a string.
+        ValueError: If `text` cannot be parsed as a filesize, including when
+            its exponent is larger than 100 in absolute value (e.g. "1e101").
+    """
+    if not isinstance(text, str):
+        msg = f"parse_size() argument must be str, not {type(text).__name__}"
+        raise TypeError(msg)
+
+    import re
+    from fractions import Fraction
+
+    match = re.fullmatch(_SIZE_PATTERN, text)
+    unit = match["unit"] if match else ""
+    if unit.lower() in ("", "byte", "bytes"):
+        multiplier = 1
+    else:
+        multiplier = _unit_multipliers.get(unit, 0)  # 0: unknown unit
+    exponent = (match["exponent"] if match else None) or "0"
+    # Check the exponent's digit count before converting it to int, so a very
+    # long digit string is rejected cheaply, then check its value.
+    exponent_digits = exponent.lstrip("+-").lstrip("0") or "0"
+    msg = f"Unable to parse size: {text!r}"
+    if (
+        match is None
+        or not multiplier
+        or len(exponent_digits) > 4
+        or int(exponent_digits) > _MAX_EXPONENT
+    ):
+        raise ValueError(msg)
+
+    exponent_value = -int(exponent_digits) if "-" in exponent else int(exponent_digits)
+    try:
+        value = (
+            Fraction(match["mantissa"]) * Fraction(10) ** exponent_value * multiplier
+        )
+    except ValueError:  # More digits than sys.get_int_max_str_digits() allows
+        raise ValueError(msg) from None
+    # Round half away from zero (built-in round() rounds half to even).
+    rounded = int(abs(value) + Fraction(1, 2))
+    return -rounded if value < 0 else rounded

+def test_parse_size_round_trip_huge(value: int, binary: bool, gnu: bool) -> None:
+    """Very large magnitudes must round-trip exactly (regression for T1 fix 1).
+
+    Previously `ctx.prec = 200` made `quantize` raise `InvalidOperation` for
+    numbers needing more than 200 significant digits.
+    """
+    rendered = humanize.naturalsize(value, binary, gnu)
+    parsed = humanize.parse_size(rendered)
+    reformatted = humanize.naturalsize(parsed, binary, gnu)
+    assert reformatted == rendered
+
+
+def test_parse_size_exact_huge_integer() -> None:
+    text = "1" * 300
+    assert humanize.parse_size(text) == int(text)
+
+
+def test_parse_size_exact_huge_integer_with_unit() -> None:
+    text = "1" * 199 + " kB"
+    assert humanize.parse_size(text) == int("1" * 199) * 1000
+
+
+def test_parse_size_no_double_rounding() -> None:
+    # 0.0004999...9 (250 nines) kB rounds to 0 kB worth of bytes, i.e. 0,
+    # not 1 as it would if the fractional part were rounded to fewer
+    # significant digits before the final quantize.
+    text = "0.0004" + "9" * 250 + " kB"
+    assert humanize.parse_size(text) == 0
+
+
<email>(
+    "text",
+    [
+        "1" * 50_000 + " x y",
+        "1." + "1" * 50_000 + " kB extra",
+    ],
+)
+def test_parse_size_no_redos(text: str) -> None:
+    """Malformed huge inputs must fail fast, not backtrack quadratically."""
+    start = time.perf_counter()
+    with pytest.raises(ValueError, match="Could not parse size"):
+        humanize.parse_size(text)
+    elapsed = time.perf_counter() - start
+    assert elapsed < 1.0

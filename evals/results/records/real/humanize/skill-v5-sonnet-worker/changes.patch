+
+_PARSE_SIZE_RE = re.compile(
+    r"^(?P<number>[+-]?(?:[0-9]+\.[0-9]*|\.[0-9]+|[0-9]+))[ \t]*(?P<unit>[A-Za-z]*)$"
+)
+
+
+def parse_size(text: str) -> int:
+    """Parse a human-readable filesize back into a number of bytes.
+
+    This is the inverse of `naturalsize`: it accepts every string that
+    `naturalsize` produces with its default `format`, namely decimal
+    suffixes (`kB`..`QB`, base 1000), binary suffixes (`KiB`..`QiB`, base
+    1024), GNU-style single-letter suffixes (`K`..`Q`, base 1024), the bare
+    suffix `B`, the words `Byte` / `Bytes`, and a bare number (interpreted as
+    bytes). A custom `format` passed to `naturalsize` (e.g. `"%.1e"`) can
+    produce a mantissa `parse_size` does not understand, and matching is
+    case-sensitive and only the untranslated English forms are recognized;
+    output produced with a non-default `format` or after
+    `humanize.activate(...)` (localized suffixes) raises `ValueError`.
+
+    Examples:
+        ```pycon
+        >>> parse_size("1 Byte")
+        1
+        >>> parse_size("300B")
+        300
+        >>> parse_size("3.0 MB")
+        3000000
+        >>> parse_size("2.9 KiB")
+        2970
+        >>> parse_size("1.0 K")
+        1024
+        >>> parse_size("1024")
+        1024
+
+        ```
+
+    Args:
+        text (str): Human-readable representation of a filesize, as produced
+            by `naturalsize`.
+
+    Returns:
+        int: The number of bytes represented by `text`.
+
+    Raises:
+        TypeError: If `text` is not a `str`.
+        ValueError: If `text` cannot be parsed as a filesize, including
+            malformed numbers, unrecognized or misspelled units, and
+            non-integer byte counts (e.g. `"1.5 Bytes"`).
+    """
+    if not isinstance(text, str):
+        msg = f"parse_size() argument must be str, not {type(text).__name__}"
+        raise TypeError(msg)
+
+    parse_error = f"Could not parse size: {text!r}"
+
+    stripped = text.strip()
+    match = _PARSE_SIZE_RE.match(stripped)
+    if not match:
+        raise ValueError(parse_error)
+
+    number_str = match.group("number")
+    unit = match.group("unit")
+
+    try:
+        number = Decimal(number_str)
+    except InvalidOperation as exc:
+        raise ValueError(parse_error) from exc
+
+    exp: int
+    base: int
+    integral_only = False
+
+    if unit in ("", "B", "Byte", "Bytes"):
+        exp, base = 0, 1
+        integral_only = True
+    elif unit in suffixes["decimal"]:
+        exp = suffixes["decimal"].index(unit) + 1
+        base = 1000
+    elif unit in suffixes["binary"]:
+        exp = suffixes["binary"].index(unit) + 1
+        base = 1024
+    elif len(unit) == 1 and unit in suffixes["gnu"]:
+        exp = suffixes["gnu"].index(unit) + 1
+        base = 1024
+    else:
+        raise ValueError(parse_error)
+
+    if integral_only and number != number.to_integral_value():
+        raise ValueError(parse_error)
+
+    multiplier = base**exp  # exact int, arbitrary precision
+    with localcontext() as ctx:
+        # `number_str` bounds the number of significant digits in `number`;
+        # a generous margin above that keeps the multiplication and the
+        # subsequent quantize exact instead of raising InvalidOperation or
+        # silently double-rounding for very long inputs.
+        ctx.prec = len(number_str) + 40
+        result = (number * Decimal(multiplier)).quantize(
+            Decimal(1), rounding=ROUND_HALF_UP
+        )
+    return int(result)

diff --git a/tests/test_types/test_Duration.py b/tests/test_types/test_Duration.py
new file mode 100644
index 0000000..e4544ab
--- /dev/null
+++ b/tests/test_types/test_Duration.py
@@ -0,0 +1,123 @@
+from datetime import timedelta
+
+import pytest
+
+import click
+
+
+def test_duration_repr_and_name():
+    assert repr(click.Duration()) == "Duration"
+    assert click.Duration.name == "duration"
+
+
<email>(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("15m", timedelta(minutes=15)),
+        ("2h", timedelta(hours=2)),
+        ("1d", timedelta(days=1)),
+        ("1.5h", timedelta(hours=1, minutes=30)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("0.5d", timedelta(hours=12)),
+        ("90", timedelta(seconds=90)),
+        ("1.5", timedelta(seconds=1.5)),
+        ("0", timedelta(0)),
+        ("0s", timedelta(0)),
+        ("  2h  ", timedelta(hours=2)),
+        (90, timedelta(seconds=90)),
+        (1.5, timedelta(seconds=1.5)),
+        ("1.5h30m", timedelta(hours=2)),
+    ],
+)
+def test_duration_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_duration_timedelta_passthrough():
+    td = timedelta(hours=1)
+    assert click.Duration().convert(td, None, None) is td
+
+    neg_td = timedelta(hours=-1)
+    assert click.Duration().convert(neg_td, None, None) is neg_td
+
+
<email>(
+    "value",
+    [
+        "",
+        "   ",
+        "abc",
+        "5x",
+        "h",
+        "1h30",
+        "30m1h",
+        "1h1h",
+        "1 h",
+        "1h 30m",
+        "-5",
+        "-1h",
+        "+5",
+        "1H",
+        ".5h",
+        "1.h",
+        "1e3",
+        "inf",
+        "nan",
+        "١٢",  # Arabic-Indic digits "12"
+        "2h\nx",
+        "99999999999d",
+        "1" * 400 + "s",
+        True,
+        -5,
+        10**30,
+        10**400,
+        float("nan"),
+        float("inf"),
+        [],
+    ],
+)
+def test_duration_convert_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert repr(value) in exc_info.value.message
+    assert "is not a valid duration" in exc_info.value.message
+
+
+def test_duration_cli_error_message(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        click.echo(timeout)
+
+    result = runner.invoke(cli, ["--timeout", "5x"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--timeout': '5x' is not a valid duration." in result.output
+    )
+
+
+def test_duration_cli_success(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, ["--timeout", "1h30m"])
+    assert result.exit_code == 0
+    assert result.output.strip() == repr(timedelta(seconds=5400))
+
+
+def test_duration_cli_default():
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default="15m")
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    from click.testing import CliRunner
+
+    result = CliRunner().invoke(cli, [])
+    assert result.exit_code == 0
+    assert result.output.strip() == repr(timedelta(minutes=15))

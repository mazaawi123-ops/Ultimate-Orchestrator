+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta` objects.
+
+    A value is either a plain number, which is interpreted as a number of
+    seconds (``"90"`` or ``90``), or one or more ``<number><unit>``
+    components written directly next to each other, such as ``"1h30m"``.
+    The available units are ``d`` (days), ``h`` (hours), ``m`` (minutes) and
+    ``s`` (seconds). Each unit may appear at most once, and the units must
+    appear in descending order (``d``, then ``h``, then ``m``, then ``s``).
+    Numbers may have a decimal point, for example ``"1.5h"``. Leading and
+    trailing whitespace is stripped, but no other whitespace is allowed.
+    Negative durations are not allowed.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _number_re = r"[0-9]+(?:\.[0-9]+)?"
+    _plain_number_re = re.compile(_number_re)
+    _components_re = re.compile(
+        rf"(?:(?P<d>{_number_re})d)?"
+        rf"(?:(?P<h>{_number_re})h)?"
+        rf"(?:(?P<m>{_number_re})m)?"
+        rf"(?:(?P<s>{_number_re})s)?"
+    )
+
+    def _parse_seconds(self, value: str) -> float | None:
+        if self._plain_number_re.fullmatch(value):
+            return float(value)
+
+        match = self._components_re.fullmatch(value)
+
+        if match is None:
+            return None
+
+        groups = match.groupdict()
+
+        if not any(groups.values()):
+            return None
+
+        seconds = 0.0
+
+        if groups["d"] is not None:
+            seconds += float(groups["d"]) * 86400
+        if groups["h"] is not None:
+            seconds += float(groups["h"]) * 3600
+        if groups["m"] is not None:
+            seconds += float(groups["m"]) * 60
+        if groups["s"] is not None:
+            seconds += float(groups["s"])
+
+        return seconds
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        seconds: float | None = None
+
+        if isinstance(value, bool):
+            pass
+        elif isinstance(value, (int, float)):
+            if value >= 0:
+                try:
+                    seconds = float(value)
+                except OverflowError:
+                    seconds = None
+        elif isinstance(value, str):
+            stripped = value.strip()
+
+            if stripped:
+                seconds = self._parse_seconds(stripped)
+
+        if seconds is not None:
+            try:
+                return timedelta(seconds=seconds)
+            except (OverflowError, ValueError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):

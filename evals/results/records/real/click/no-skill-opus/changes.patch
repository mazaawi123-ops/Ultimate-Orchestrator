<email>("default", ["1h", timedelta(hours=1)])
+def test_option_default(runner, default):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default=default)
+    def cli(timeout):
+        assert timeout == timedelta(hours=1)
+
+        if isinstance(default, timedelta):
+            assert timeout is default
+
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0, result.output

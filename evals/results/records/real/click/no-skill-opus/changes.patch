+def timeout_cli():
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default=90)
+    def cli(timeout):
+        assert isinstance(timeout, timedelta)
+        click.echo(timeout.total_seconds())
+
+    return cli
+
+
<email>(
+    ("args", "expect"),
+    [
+        (["--timeout", "1h30m"], "5400.0"),
+        (["--timeout", "1.5m"], "90.0"),
+        ([], "90.0"),
+    ],
+)
+def test_option(runner, timeout_cli, args, expect):
+    result = runner.invoke(timeout_cli, args)
+    assert result.exit_code == 0, result.output
+    assert result.output == f"{expect}\n"
+
+
<email>("value", ["30m1h", "999999999999d"])
+def test_option_invalid(runner, timeout_cli, value):

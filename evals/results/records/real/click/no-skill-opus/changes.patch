+from datetime import timedelta
+
+import pytest
+
+import click
+
+
<email>(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("15m", timedelta(minutes=15)),
+        ("2h", timedelta(hours=2)),
+        ("1d", timedelta(days=1)),
+        ("0s", timedelta()),
+        ("1.5h", timedelta(hours=1, minutes=30)),
+        (".5h", timedelta(minutes=30)),
+        ("1.h", timedelta(hours=1)),
+        ("0.25m", timedelta(seconds=15)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("2h15s", timedelta(hours=2, seconds=15)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1.5h30m", timedelta(hours=2)),
+        ("90", timedelta(seconds=90)),
+        ("1.5", timedelta(seconds=1.5)),
+        (".5", timedelta(seconds=0.5)),
+        ("1.", timedelta(seconds=1)),
+        ("  1h30m  ", timedelta(hours=1, minutes=30)),
+        ("\t90\n", timedelta(seconds=90)),
+        (90, timedelta(seconds=90)),
+        (0, timedelta()),
+        (1.5, timedelta(seconds=1.5)),
+    ],
+)
+def test_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_timedelta_identity():
+    value = timedelta(hours=1)
+    assert click.Duration().convert(value, None, None) is value
+
+
<email>(
+    "value",
+    [
+        "",
+        "   ",
+        "1h 30m",
+        "30m1h",
+        "1h1h",
+        "2H",
+        "1M",
+        "1w",
+        "1ms",
+        "-5s",
+        "-5",
+        "+5",
+        "1e3",
+        "1_000",
+        "inf",
+        "nan",
+        "abc",
+        "h",
+        "1.5.5h",
+        "1h30",
+        ".",
+        ".h",
+        "1h\n30m",
+        "١s",
+        True,
+        False,
+        -1,
+        -0.5,
+        float("inf"),
+        float("nan"),
+        None,
+        ["1h"],
+    ],
+)
+def test_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    message = exc_info.value.message
+    assert repr(value) in message
+    assert "is not a valid duration" in message
+
+
<email>("value", ["999999999999d", "9" * 400, 10**20])
+def test_overflow(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert repr(value) in exc_info.value.message
+    assert "too large" in exc_info.value.message
+
+
+def test_repr():
+    assert repr(click.Duration()) == "Duration"
+
+

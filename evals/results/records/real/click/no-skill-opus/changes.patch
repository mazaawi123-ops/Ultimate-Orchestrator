+_DURATION_NUMBER = r"(?:\d+(?:\.\d*)?|\.\d+)"
+_DURATION_RE = re.compile(
+    rf"(?P<seconds>{_DURATION_NUMBER})"
+    rf"|(?:(?P<d>{_DURATION_NUMBER})d)?"
+    rf"(?:(?P<h>{_DURATION_NUMBER})h)?"
+    rf"(?:(?P<m>{_DURATION_NUMBER})m)?"
+    rf"(?:(?P<s>{_DURATION_NUMBER})s)?",
+    re.ASCII,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into ``timedelta``
+    objects.
+
+    A duration is a non-negative number followed by a unit: ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), or ``s`` (seconds), such as ``90s``,
+    ``15m``, ``2h``, or ``1d``. Numbers may have a decimal part, such as
+    ``1.5h``. Units can be combined, each at most once and in the order
+    ``d``, ``h``, ``m``, ``s``, without spaces, such as ``1h30m`` or
+    ``1d2h3m4s``. Units are lowercase only.
+
+    A plain number without a unit, such as ``90`` or ``1.5``, is a number of
+    seconds. Leading and trailing whitespace is ignored.
+
+    A ``timedelta`` value is returned unchanged. An ``int`` or ``float``
+    value, such as a ``default``, is a number of seconds.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        try:
+            # bool is a subclass of int, but True is not a duration.
+            if isinstance(value, (int, float)) and not isinstance(value, bool):
+                # Rejects negative, infinite, and NaN values.
+                if 0 <= value < float("inf"):
+                    return timedelta(seconds=value)
+            elif isinstance(value, str):
+                match = _DURATION_RE.fullmatch(value.strip())
+
+                if match is not None and any(match.groups()):
+                    if match["seconds"] is not None:
+                        return timedelta(seconds=float(match["seconds"]))
+
+                    return timedelta(
+                        days=float(match["d"] or 0),
+                        hours=float(match["h"] or 0),
+                        minutes=float(match["m"] or 0),
+                        seconds=float(match["s"] or 0),
+                    )
+        except OverflowError:
+            self.fail(
+                _("{value!r} is too large to be a duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+        self.fail(
+            _(
+                "{value!r} is not a valid duration. Use a number of seconds or"
+                " units d, h, m, s, such as '1h30m'."
+            ).format(value=value),
+            param,
+            ctx,
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):

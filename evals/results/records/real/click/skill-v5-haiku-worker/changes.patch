+_DURATION_NUMBER = r"[0-9]+(?:\.[0-9]+)?"
+_DURATION_SECONDS_RE = re.compile(_DURATION_NUMBER)
+_DURATION_RE = re.compile(
+    rf"(?:(?P<days>{_DURATION_NUMBER})d)?"
+    rf"(?:(?P<hours>{_DURATION_NUMBER})h)?"
+    rf"(?:(?P<minutes>{_DURATION_NUMBER})m)?"
+    rf"(?:(?P<seconds>{_DURATION_NUMBER})s)?"
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `datetime.timedelta`
+    objects.
+
+    Accepts values in the following formats:
+
+    - A plain number is interpreted as seconds.
+    - A duration string with units: a combination of days (d), hours (h),
+      minutes (m), and seconds (s), in that order. For example, ``1h30m``,
+      ``90s``, or ``1d2h3m4s``.
+    - Decimals are accepted in any unit, such as ``1.5h``.
+    - Already a `datetime.timedelta` object, which is returned unchanged
+      (including a negative one).
+
+    Negative numbers and strings are rejected. A nonzero value that is
+    smaller than one microsecond (and therefore would round down to a zero
+    duration) is also rejected.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    def _fail_invalid(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> t.NoReturn:
+        self.fail(
+            _(
+                "{value!r} is not a valid duration. Use a number of "
+                "seconds or a combination of days, hours, minutes and "
+                "seconds, such as '90s', '1.5h' or '1h30m'."
+            ).format(value=value),
+            param,
+            ctx,
+        )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, (int, float)) and not isinstance(value, bool):
+            if not value >= 0:
+                self._fail_invalid(value, param, ctx)
+
+            try:
+                result = timedelta(seconds=value)
+            except (OverflowError, ValueError):
+                self._fail_invalid(value, param, ctx)
+
+            if value > 0 and result == timedelta(0):
+                self._fail_invalid(value, param, ctx)
+
+            return result
+
+        if isinstance(value, str):
+            text = value.strip()
+
+            if _DURATION_SECONDS_RE.fullmatch(text):
+                parts = {"seconds": float(text)}
+            else:
+                match = _DURATION_RE.fullmatch(text)
+                if match is None:
+                    self._fail_invalid(value, param, ctx)
+
+                parts = {
+                    k: float(v) for k, v in match.groupdict().items() if v is not None
+                }
+                if not parts:
+                    self._fail_invalid(value, param, ctx)
+
+            try:
+                result = timedelta(**parts)
+            except (OverflowError, ValueError):
+                self._fail_invalid(value, param, ctx)
+
+            if any(v > 0 for v in parts.values()) and result == timedelta(0):
+                self._fail_invalid(value, param, ctx)
+
+            return result
+
+        self._fail_invalid(value, param, ctx)
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):

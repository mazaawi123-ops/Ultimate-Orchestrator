diff --git a/tests/test_types/test_Duration.py b/tests/test_types/test_Duration.py
new file mode 100644
index 0000000..7e5843b
--- /dev/null
+++ b/tests/test_types/test_Duration.py
@@ -0,0 +1,168 @@
+from datetime import timedelta
+
+import pytest
+
+import click
+from click.testing import CliRunner
+
+
<email>(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("15m", timedelta(minutes=15)),
+        ("2h", timedelta(hours=2)),
+        ("1d", timedelta(days=1)),
+        ("1.5h", timedelta(hours=1, minutes=30)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("2h15s", timedelta(hours=2, seconds=15)),
+        ("1.5h30m", timedelta(hours=2)),
+        ("1.1h", timedelta(seconds=3960)),
+        ("0.000001s", timedelta(microseconds=1)),
+        ("90", timedelta(seconds=90)),
+        ("1.5", timedelta(seconds=1.5)),
+        ("0", timedelta(0)),
+        ("0s", timedelta(0)),
+        ("  2h ", timedelta(hours=2)),
+        (90, timedelta(seconds=90)),
+        (1.5, timedelta(seconds=1.5)),
+        (0, timedelta(0)),
+        ("0.0s", timedelta(0)),
+        ("0h0m", timedelta(0)),
+        ("0.000000s", timedelta(0)),
+        (0.0, timedelta(0)),
+        ("0.0000001h", timedelta(microseconds=360)),
+        ("0.0000015s", timedelta(microseconds=2)),
+    ],
+)
+def test_duration_valid(value, expect):
+    result = click.Duration().convert(value, None, None)
+    assert result == expect
+
+
<email>(
+    ("value",),
+    [
+        (timedelta(minutes=5),),
+        (timedelta(0),),
+        (timedelta(seconds=-5),),
+    ],
+)
+def test_duration_passthrough(value):
+    """timedelta inputs are returned unchanged (identity)."""
+    result = click.Duration().convert(value, None, None)
+    assert result is value
+
+
<email>(
+    ("value",),
+    [
+        ("",),
+        ("   ",),
+        ("abc",),
+        ("h",),
+        ("1x",),
+        ("1w",),
+        ("1ms",),
+        ("2H",),
+        ("1h 30m",),
+        ("30m1h",),
+        ("1h1h",),
+        ("-5",),
+        ("+5",),
+        ("-1h",),
+        ("1e3",),
+        ("inf",),
+        ("nan",),
+        ("1_000",),
+        (".5h",),
+        ("1.h",),
+        ("1.5.2h",),
+        ("١h",),  # Arabic-Indic digit one + h
+        ("²s",),  # superscript 2 + s
+        ("999999999999d",),
+        ("9" * 400,),
+        (True,),
+        (False,),
+        (None,),
+        (b"90s",),
+        ([1],),
+        (-1,),
+        (-0.5,),
+        (float("nan"),),
+        (float("inf"),),
+        (10**20,),
+        ("0.0000005s",),
+        ("0.0000004s",),
+        (1e-7,),
+        (5e-7,),
+    ],
+)
+def test_duration_invalid(value):
+    """Invalid values raise click.BadParameter."""
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    message = exc_info.value.message
+    assert "is not a valid duration" in message
+    assert repr(value) in message
+
+
+def test_duration_cli():
+    """Test Duration through the CLI."""
+
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cmd(timeout):
+        click.echo(repr(timeout))
+
+    runner = CliRunner()
+
+    # Valid: 1h30m
+    result = runner.invoke(cmd, ["--timeout", "1h30m"])
+    assert result.exit_code == 0
+    assert "datetime.timedelta(seconds=5400)" in result.output
+
+    # Invalid: 1x
+    result = runner.invoke(cmd, ["--timeout", "1x"])
+    assert result.exit_code == 2
+    assert "Invalid value for '--timeout'" in result.output
+    assert "'1x'" in result.output
+
+
+def test_duration_defaults():
+    """Test Duration with defaults."""
+
+    @click.command()
+    @click.option("--timeout-int", type=click.Duration(), default=90)
+    @click.option("--timeout-str", type=click.Duration(), default="2h")
+    def cmd(timeout_int, timeout_str):
+        click.echo(f"int:{repr(timeout_int)}")
+        click.echo(f"str:{repr(timeout_str)}")
+
+    runner = CliRunner()
+    result = runner.invoke(cmd, [])
+    assert result.exit_code == 0
+    assert "datetime.timedelta(seconds=90)" in result.output
+    assert "datetime.timedelta(seconds=7200)" in result.output
+
+
+def test_duration_repr():
+    """Test repr and name."""
+    d = click.Duration()
+    assert repr(d) == "Duration"
+    assert d.name == "duration"
+
+
+def test_duration_is_param_type():
+    """Test that Duration is a ParamType."""
+    d = click.Duration()
+    assert isinstance(d, click.ParamType)
+
+
+def test_duration_to_info_dict():
+    """Test to_info_dict."""
+    d = click.Duration()
+    info = d.to_info_dict()
+    assert info == {"param_type": "Duration", "name": "duration"}
